copyAvatarBtn.MouseButton1Click:Connect(function()
	playerList.Visible = false
	bundleList.Visible = false

	if not selectedTargetPlayer then  
		selectPlayerBtn.Text = "SELECT A PLAYER FIRST"  
		task.wait(1.5)  
		selectPlayerBtn.Text = selectedTargetPlayer and ("SELECTED: " .. string.upper(selectedTargetPlayer.Name)) or "SELECT PLAYER"  
		return  
	end  
	  
	local targetChar = selectedTargetPlayer.Character  
	if not targetChar then  
		copyAvatarBtn.Text = "PLAYER NOT SPAWNED"  
		task.wait(1.5)  
		copyAvatarBtn.Text = "COPY AVATAR"  
		return  
	end  

	copyAvatarBtn.Text = "SCANNING..."  

	-- HIGH EFFICIENCY MULTI-PASS: 6 passes to catch all asynchronously loaded gear/clothing  
	local finalTargetData = { body = {}, accessory = {}, allDict = {} }  
	local scanPasses = 6  
	  
	for i = 1, scanPasses do  
		local passData = extractIdsFromCharacter(targetChar)  
		for _, id in ipairs(passData.body) do  
			if not finalTargetData.allDict[id] then  
				finalTargetData.allDict[id] = true  
				table.insert(finalTargetData.body, id)  
			end  
		end  
		for _, id in ipairs(passData.accessory) do  
			if not finalTargetData.allDict[id] then  
				finalTargetData.allDict[id] = true  
				table.insert(finalTargetData.accessory, id)  
			end  
		end  
		if i < scanPasses then task.wait(0.1) end   
	end  

	-- Sync Body Scales and Colors  
	local targetColors = targetChar:FindFirstChildOfClass("BodyColors")  
	local myColors = character:FindFirstChildOfClass("BodyColors")  
	if targetColors then  
		if myColors then myColors:Destroy() end  
		targetColors:Clone().Parent = character  
	end  

	local targetHum = targetChar:FindFirstChildOfClass("Humanoid")  
	local myHum = character:FindFirstChildOfClass("Humanoid")  
	if targetHum and myHum then  
		for _, scaleName in ipairs({"BodyTypeScale", "BodyProportionScale", "BodyWidthScale", "BodyHeightScale", "BodyDepthScale", "HeadScale"}) do  
			local targetScale = targetHum:FindFirstChild(scaleName)  
			local myScale = myHum:FindFirstChild(scaleName)  
			if targetScale and myScale then  
				myScale.Value = targetScale.Value  
			elseif targetScale and not myScale then  
				targetScale:Clone().Parent = myHum  
			end  
		end  
	end  

	copyAvatarBtn.Text = "COPY AVATAR"  
	task.spawn(function()  
		executeEquip(finalTargetData.body, finalTargetData.accessory, finalTargetData.allDict, false)  
	end)
end)

