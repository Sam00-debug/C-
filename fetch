-- --- Core Engine Extraction & Optimization (FIXED FOR LAYERED CLOTHING) ---
local function extractIdsFromCharacter(targetChar)
	local extractedData = { body = {}, accessory = {}, allDict = {} }
	if not targetChar then return extractedData end

	local function registerId(rawData, isBody)
		if not rawData then return end
		-- Extracts ALL sets of 5+ digits (Filters out irrelevant small numbers)
		for numStr in string.gmatch(tostring(rawData), "%d%d%d%d%d+") do
			local idNum = tonumber(numStr)
			-- Verify the ID is valid and hasn't been added yet
			if idNum and idNum > 9999 and not extractedData.allDict[idNum] then
				extractedData.allDict[idNum] = true
				if isBody then
					table.insert(extractedData.body, idNum)
				else
					table.insert(extractedData.accessory, idNum)
				end
			end
		end
	end

	local hum = targetChar:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function()
			local desc = hum:GetAppliedDescription()
			if desc then
				-- Body scales and parts
				local bodyTypes = {"Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg", "Face"}
				for _, bType in ipairs(bodyTypes) do
					if desc[bType] and desc[bType] ~= "" and desc[bType] ~= 0 then
						registerId(desc[bType], true)
					end
				end
				-- Comprehensive list including all hairs and 3D Layered Clothes
				local accTypes = {
					"HairAccessory", "BackAccessory", "FaceAccessory", "FrontAccessory",
					"HatAccessory", "NeckAccessory", "ShouldersAccessory", "WaistAccessory",
					"Shirt", "Pants", "GraphicTShirt",
					"ShirtAccessory", "PantsAccessory", "TShirtAccessory",
					"SweaterAccessory", "JacketAccessory", "ShortsAccessory",
					"DressSkirtAccessory", "LeftShoeAccessory", "RightShoeAccessory"
				}
				for _, aType in ipairs(accTypes) do
					if desc[aType] and desc[aType] ~= "" and desc[aType] ~= 0 then
						registerId(desc[aType], false)
					end
				end
			end
		end)
	end

	-- SUPERCHARGED FALLBACK SCANNER
	for _, item in ipairs(targetChar:GetDescendants()) do
		-- 1. Catch IDs in names (e.g. "Jacket-Denim-Blue-8516609675")
		registerId(item.Name, false)
		
		-- 2. Explicit fallback for standard 2D Clothes
		if item:IsA("Shirt") then
			registerId(item.ShirtTemplate, false)
		elseif item:IsA("Pants") then
			registerId(item.PantsTemplate, false)
		elseif item:IsA("ShirtGraphic") then
			registerId(item.Graphic, false)
			
		-- 3. Extract Mesh IDs for Layered Clothing & 3D Accessories missing ID tags in names
		elseif item:IsA("MeshPart") then
			registerId(item.MeshId, false)
			registerId(item.TextureID, false)
		elseif item:IsA("SpecialMesh") then
			registerId(item.MeshId, false)
			registerId(item.TextureId, false)
		end
		
		-- 4. Deep search for hidden Values (Brookhaven obfuscates items here)
		if item:IsA("IntValue") or item:IsA("StringValue") or item:IsA("NumberValue") then
			registerId(item.Value, false)
		end
		
		-- 5. Deep search through Attributes
		pcall(function()
			for _, attrValue in pairs(item:GetAttributes()) do
				registerId(tostring(attrValue), false)
			end
		end)
	end

	return extractedData
end


local function executeEquip(targetBodyIds, targetAccessoryIds, targetDict, keepExisting)
	local myCurrentData = extractIdsFromCharacter(character)

	-- Calculate what to equip  
	local finalBodyIds = {}  
	for _, id in ipairs(targetBodyIds) do  
		if not myCurrentData.allDict[id] then table.insert(finalBodyIds, id) end  
	end  

	local finalAccessoryIds = {}  
	for _, id in ipairs(targetAccessoryIds) do  
		if not myCurrentData.allDict[id] then table.insert(finalAccessoryIds, id) end  
	end  

	-- Calculate what to unequip (Only run if keepExisting is false/nil)  
	local idsToUnequip = {}  
	if not keepExisting then  
		for id, _ in pairs(myCurrentData.allDict) do  
			if not targetDict[id] then table.insert(idsToUnequip, id) end  
		end  
	end  

	local totalOperations = #finalBodyIds + #finalAccessoryIds + #idsToUnequip  
	isCancelling = false  
	blockerText.Text = "equipping wait..."  

	if totalOperations == 0 then   
		copyAvatarBtn.Text = "ALREADY WEARING AVATAR"  
		task.wait(1.5)  
		copyAvatarBtn.Text = "COPY AVATAR"  
		return   
	end  
	  
	blockerFrame.Visible = true  

	-- --- PHASE 1: UNEQUIP UNWANTED ITEMS (CANCELLABLE) ---  
	if #idsToUnequip > 0 then  
		isEquippingBody = false  
		cancelBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)  
		cancelBtn.Text = "CANCEL (UNEQUIP)"  
		  
		for _, id in ipairs(idsToUnequip) do  
			if isCancelling then break end  
			pcall(function() wearRemote:InvokeServer(id) end)  
			task.wait(WAIT_BETWEEN_ITEMS)  
		end  
		  
		if isCancelling then   
			blockerFrame.Visible = false  
			return  
		end  
	end  
	  
	-- --- PHASE 2: EQUIP BODY (UNCANCELLABLE) ---  
	if #finalBodyIds > 0 then  
		isEquippingBody = true  
		cancelBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)  
		cancelBtn.Text = "LOADING BODY..."  
		  
		for _, id in ipairs(finalBodyIds) do  
			pcall(function() wearRemote:InvokeServer(id) end)  
			task.wait(WAIT_BETWEEN_ITEMS)  
		end  
	end  
	  
	-- --- PHASE 3: EQUIP ACCESSORIES/CLOTHING (CANCELLABLE) ---  
	if #finalAccessoryIds > 0 then  
		isEquippingBody = false  
		cancelBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)  
		cancelBtn.Text = "CANCEL (EQUIP)"  
		  
		for _, id in ipairs(finalAccessoryIds) do  
			if isCancelling then break end  
			pcall(function() wearRemote:InvokeServer(id) end)  
			task.wait(WAIT_BETWEEN_ITEMS)  
		end  
	end  
	  
	blockerFrame.Visible = false
end

