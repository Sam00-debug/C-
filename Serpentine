local function createSlider(parent, name, minValue, maxValue, defaultValue, callback)
    local holder = Instance.new("Frame", parent)
    holder.Size = UDim2.fromScale(0.92, 0.16)
    holder.BackgroundColor3 = Color3.fromRGB(25, 35, 25)
    holder.BorderSizePixel = 0

    Instance.new("UICorner", holder).CornerRadius = UDim.new(0.12, 0)

    -- Name
    local label = Instance.new("TextLabel", holder)
    label.Size = UDim2.fromScale(0.7, 0.35)
    label.Position = UDim2.fromScale(0.05, 0.05)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(220,220,220)
    label.Font = Enum.Font.GothamSemibold
    label.TextScaled = true
    label.TextXAlignment = Enum.TextXAlignment.Left

    -- Value
    local valueLabel = Instance.new("TextLabel", holder)
    valueLabel.Size = UDim2.fromScale(0.25, 0.35)
    valueLabel.Position = UDim2.fromScale(0.7, 0.05)
    valueLabel.BackgroundTransparency = 1
    valueLabel.TextColor3 = Color3.fromRGB(150,255,150)
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextScaled = true
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    -- Slider background
    local slider = Instance.new("Frame", holder)
    slider.Size = UDim2.fromScale(0.88, 0.16)
    slider.Position = UDim2.fromScale(0.06, 0.58)
    slider.BackgroundColor3 = Color3.fromRGB(55,65,55)
    slider.BorderSizePixel = 0

    Instance.new("UICorner", slider).CornerRadius = UDim.new(1,0)

    -- Slider fill
    local fill = Instance.new("Frame", slider)
    fill.Size = UDim2.fromScale(0,1)
    fill.BackgroundColor3 = Color3.fromRGB(50,200,100)
    fill.BorderSizePixel = 0

    Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)

    -- Slider knob
    local knob = Instance.new("TextButton", slider)
    knob.AnchorPoint = Vector2.new(0.5,0.5)
    knob.Size = UDim2.fromScale(0.06,2.2)
    knob.Position = UDim2.fromScale(0,0.5)
    knob.BackgroundColor3 = Color3.fromRGB(220,255,220)
    knob.Text = ""

    Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)

    local draggingSlider = false

    local function setValueFromX(x)
        local relative = math.clamp((x - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
        local value = minValue + ((maxValue - minValue) * relative)

        -- Round to 2 decimals
        value = math.round(value * 100) / 100
        local percent = (value - minValue) / (maxValue - minValue)

        fill.Size = UDim2.fromScale(percent,1)
        knob.Position = UDim2.fromScale(percent,0.5)
        valueLabel.Text = tostring(value)
        callback(value)
    end

    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            setValueFromX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider then
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                setValueFromX(input.Position.X)
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)

    -- Set initial value
    local initialPercent = (defaultValue - minValue) / (maxValue - minValue)
    fill.Size = UDim2.fromScale(initialPercent,1)
    knob.Position = UDim2.fromScale(initialPercent,0.5)
    valueLabel.Text = tostring(defaultValue)

    return holder
end

