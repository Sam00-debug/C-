-- --- HELPER: SAMPLE PATH HISTORY FOR BODY ---
local function getPathCFrameAtDistance(targetDist: number): CFrame
    if #pathHistory == 0 then return CFrame.new() end
    if #pathHistory == 1 or targetDist <= 0 then return pathHistory[1] end
    
    local accumulated = 0
    for j = 1, #pathHistory - 1 do
        local pt1 = pathHistory[j]
        local pt2 = pathHistory[j+1]
        local dist = (pt1.Position - pt2.Position).Magnitude
        
        if accumulated + dist >= targetDist then
            local alpha = (targetDist - accumulated) / dist
            return pt1:Lerp(pt2, alpha)
        end
        accumulated = accumulated + dist
    end
    return pathHistory[#pathHistory]
end

-- --- DYNAMIC SNAKE MATH & REPLICATION LOOP ---
function startSnakeReplication()
    local nextNetworkUpdate = 0
    local traveledDistance = 0
    local lastPlayerPos = nil
    
    -- Universal Rotation for Props
    local dynPropRotation = CFrame.Angles(
        math.rad(PROP_ROTATION_X - 360),
        math.rad(PROP_ROTATION_Y - 360),
        math.rad(PROP_ROTATION_Z - 360)
    )
    
    trackingConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if not activeTracking then return end
        
        local char = lp.Character
        local rootPart = char and char:FindFirstChild("HumanoidRootPart") :: BasePart
        
        if char and rootPart then
            local rootPos = rootPart.Position
            local velocityMag = Vector3.new(rootPart.Velocity.X, 0, rootPart.Velocity.Z).Magnitude
            
            -- Detect if player is actively moving
            local isMoving = velocityMag > 1.5 
            
            if not lastPlayerPos then lastPlayerPos = rootPos end
            local distMoved = (Vector3.new(rootPos.X, 0, rootPos.Z) - Vector3.new(lastPlayerPos.X, 0, lastPlayerPos.Z)).Magnitude
            lastPlayerPos = rootPos
            
            local t = tick()
            local _, yaw, _ = rootPart.CFrame:ToEulerAnglesYXZ()
            local baseCFrame = CFrame.new(rootPos) * CFrame.Angles(0, yaw, 0) * CFrame.new(0, -defaultUserHipHeight, 0)
            
            local GAP = SETTINGS.Gap
            
            -- Fill path history immediately behind player if empty
            if #pathHistory == 0 then
                for k = 1, 100 do
                    table.insert(pathHistory, baseCFrame * CFrame.new(0, 1, k * RECORD_RESOLUTION))
                end
            end
            
            -- NEW LOGIC: Only update path and targets WHEN MOVING. 
            if isMoving then
                traveledDistance = traveledDistance + distMoved
                
                -- Sine Wave Logic tied to sliders
                local A = SETTINGS.Amplitude    
                local k_wave = SETTINGS.WaveFrequency                  
                local omega = SETTINGS.Omega                   
                
                local waveX = A * math.sin((traveledDistance * k_wave) - (t * omega))
                local waveDerivative = A * k_wave * math.cos((traveledDistance * k_wave) - (t * omega))
                local yawOffset = math.atan(-waveDerivative)
                
                -- Create wavy path behind user using Scale Setting
                local virtualHeadCFrame = baseCFrame * CFrame.new(waveX, 1, SETTINGS.Scale * 0.8) * CFrame.Angles(0, yawOffset, 0)
                
                if (virtualHeadCFrame.Position - pathHistory[1].Position).Magnitude >= RECORD_RESOLUTION then
                    table.insert(pathHistory, 1, virtualHeadCFrame)
                    if #pathHistory > MAX_HISTORY_LENGTH then
                        table.remove(pathHistory)
                    end
                end
                
                -- Update Targets ONLY while moving
                for i = 1, #propsCache do
                    if i == 1 then
                        targetCFrames[1] = pathHistory[1]
                    else
                        local targetDist = (i - 1) * GAP
                        targetCFrames[i] = getPathCFrameAtDistance(targetDist)
                    end
                end
            end

            local shouldNetworkUpdate = t >= nextNetworkUpdate
            if shouldNetworkUpdate then nextNetworkUpdate = t + 0.1 end
            
            -- Apply CFrames (Moving or Stopped)
            for i = 1, #propsCache do
                local prop = propsCache[i]
                
                if not targetCFrames[i] then targetCFrames[i] = baseCFrame end
                if not segmentCFrames[i] then segmentCFrames[i] = targetCFrames[i] end
                
                -- Smoothly follow the target using Smoothness Setting
                segmentCFrames[i] = segmentCFrames[i]:Lerp(targetCFrames[i], SETTINGS.Smoothness)
                
                -- Apply the Universal Rotation directly to every single prop 
                local finalPropCFrame = segmentCFrames[i] * dynPropRotation
                
                if prop.PrimaryPart then
                    prop:SetPrimaryPartCFrame(finalPropCFrame)
                end
                
                if shouldNetworkUpdate then
                    local remote = prop:FindFirstChild("SetCurrentCFrame")
                    if remote and remote:IsA("RemoteFunction") then
                        task.spawn(function() pcall(function() remote:InvokeServer(finalPropCFrame) end) end)
                    end
                end
            end
        end
    end)
end
