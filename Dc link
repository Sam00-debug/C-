local httpService = game:GetService("HttpService")
local starterGui = game:GetService("StarterGui")

local inviteCode = "GysbMZrGBd"
local fullLink = "https://discord.gg/" .. inviteCode

-- Copy first
if setclipboard then
    setclipboard(fullLink)
elseif toclipboard then
    toclipboard(fullLink)
end

-- Notify
game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "Discord",
    Text = " copied! Paste in browser/chrome.",
    Duration = 5
})

-- Then try opening (executor-specific)
if typeof(openurl) == "function" then
    pcall(function()
        openurl(fullLink)
    end)
elseif typeof(openUrl) == "function" then
    pcall(function()
        openUrl(fullLink)
    end)
end
