local function getPlayerHouse()
    local lots = workspace:FindFirstChild("001_Lots")
    if not lots then return nil end
    local house = lots:FindFirstChild(player.Name .. "House") or lots:FindFirstChild(player.Name .. " House")
    if house and house:FindFirstChild("HousePickedByPlayer") and house.HousePickedByPlayer:FindFirstChild("HouseModel") then
        return house
    end
    return nil
end

local function getClosestManualPosition(houseFolder)
    local samplePart = houseFolder:FindFirstChildWhichIsA("BasePart", true)
    if not samplePart then return manualPositions[1] end
    local samplePos = samplePart.Position
    local closestPos = manualPositions[1]
    local minDistance = math.huge
    for _, pos in ipairs(manualPositions) do
        local dist = (samplePos - pos).Magnitude
        if dist < minDistance then
            minDistance = dist
            closestPos = pos
        end
    end
    return closestPos
end

local isMacroActive = false

local function executeHouseMacro(actionType)
    if isMacroActive or not character:FindFirstChild("HumanoidRootPart") then return end
    local houseFolder = getPlayerHouse()
    if not houseFolder then return end 
    
    isMacroActive = true
    local rootPart = character.HumanoidRootPart
    local originalCFrame = rootPart.CFrame
    
    local targetPosition = getClosestManualPosition(houseFolder)
    rootPart.CFrame = CFrame.new(targetPosition + Vector3.new(0, 2, 0))
    task.wait(1)

    local houseModel = houseFolder.HousePickedByPlayer.HouseModel
    local clearPropsRemote = houseModel:FindFirstChild("Permissions:ClearProps")
    local disallowRemote = houseModel:FindFirstChild("Permissions:Disallow")

    if actionType == "Prop" or actionType == "Both" then
        if clearPropsRemote then pcall(function() clearPropsRemote:InvokeServer() end) end
    end
    if actionType == "Bang" or actionType == "Both" then
        if disallowRemote then
            for _, target in pairs(Players:GetPlayers()) do
                if target ~= player then pcall(function() disallowRemote:FireServer(target) end) end
            end
        end
    end

    task.wait(0.2)
    rootPart.CFrame = originalCFrame
    isMacroActive = false
end

-- ==========================================
-- REMOTE HOOK (PropMaker Anti-Bang)
-- ==========================================
if hookmetamethod and not _G.PropBoxHookLoaded then
    _G.PropBoxHookLoaded = true
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        -- Detect the exact remote call for deselecting PropMaker
        if not checkcaller() and method == "InvokeServer" and self.Name == "1Too1l" then
            if type(args[1]) == "string" and args[1] == "PickingTools" and type(args[2]) == "string" and args[2] == "PropMaker" then
                -- Triggers Anti-Bang Logic
                task.spawn(executeHouseMacro, "Bang")
            end
        end
        
        return oldNamecall(self, ...)
    end)
end

