-- ==========================================
-- EFFICIENT GLOBAL COLLISION DISABLER
-- ==========================================
local function DeepDisableCollision(model)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
end

-- ==========================================
-- BACKGROUND LOGIC LOOP
-- ==========================================
if _G.ProtectionLogicConnection then _G.ProtectionLogicConnection:Disconnect() end

local timeElapsed = 0

_G.ProtectionLogicConnection = RunService.Heartbeat:Connect(function(deltaTime)
    timeElapsed += deltaTime

    if LockOverlay then LockOverlay.Visible = getPlayerHouse() == nil end

    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart

    -- No Sit Logic
    if Toggles["No Sit"] and humanoid.Sit then humanoid.Sit = false end

    -- No Clip Logic
    if Toggles["No Clip"] then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
        end
    end

    -- Region-based Collision filters for misc objects (Carts, Chairs)
    local activeMiscTags = {}
    if Toggles["Anti Cart"] then table.insert(activeMiscTags, "cart") end
    if Toggles["Anti Chair"] then table.insert(activeMiscTags, "chair") end

    if #activeMiscTags > 0 then
        local region = Region3.new(hrp.Position - Vector3.new(20,20,20), hrp.Position + Vector3.new(20,20,20))
        local partsInRegion = workspace:FindPartsInRegion3(region, character, 50)
        for _, part in ipairs(partsInRegion) do
            local name = string.lower(part.Name)
            for _, tag in ipairs(activeMiscTags) do
                if string.find(name, tag) then
                    part.CanCollide = false
                end
            end
        end
    end

    -- 1-Second Interval Heavy Logic
    if timeElapsed >= 1 then
        timeElapsed = 0

        -- 1. GLOBAL COLLISION REMOVER (Vehicles, Doors, Soccerballs)
        if Toggles["No Col - Vehicles"] or Toggles["Anti Car Troll"] or Toggles["Anti Bus Fling"] or Toggles["Anti Boat Fling"] or Toggles["Anti Jet Fling"] then
            local vehicles = workspace:FindFirstChild("Vehicles")
            if vehicles then DeepDisableCollision(vehicles) end
        end

        if Toggles["No Col - Door"] then
            local lots = workspace:FindFirstChild("001_Lots")
            if lots then
                for _, descendant in ipairs(lots:GetChildren()) do
                    -- Looks for door models within all house plots
                    for _, doorMatch in ipairs(descendant:GetDescendants()) do
                        if string.find(string.lower(doorMatch.Name), "door") then
                            DeepDisableCollision(doorMatch)
                        end
                    end
                end
            end
        end

        if Toggles["No Col - SoccerBall"] or Toggles["Anti Ball Fling"] then
            for _, obj in ipairs(workspace:GetChildren()) do
                if string.find(string.lower(obj.Name), "ball") then
                    DeepDisableCollision(obj)
                end
            end
        end

        -- 2. Anti Bang (Physical proximity check)
        if Toggles["Anti Bang"] and not isMacroActive then
            local triggerBang = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local targetHRP = p.Character.HumanoidRootPart
                    local dist = (targetHRP.Position - hrp.Position).Magnitude
                    if dist < 3.5 then
                        triggerBang = true
                        break
                    end
                end
            end
            if triggerBang then
                task.spawn(executeHouseMacro, "Bang")
            end
        end

        -- 3. Anti Prop Troll (Prop proximity check -> executes Antibang logic)
        if Toggles["Anti Prop Troll"] and not isMacroActive then
            local triggerProp = false
            local region = Region3.new(hrp.Position - Vector3.new(8,8,8), hrp.Position + Vector3.new(8,8,8))
            local nearbyParts = workspace:FindPartsInRegion3(region, character, 50)
            
            for _, part in ipairs(nearbyParts) do
                if part.Name == "Touch" and part.Parent then
                    local parentName = part.Parent.Name
                    -- Match format Prop(Username)
                    if string.match(parentName, "^Prop%(") then
                        -- Exception: Ignore user's own props
                        if parentName ~= "Prop(" .. player.Name .. ")" then
                            triggerProp = true
                            break
                        end
                    end
                end
            end
            
            if triggerProp then
                task.spawn(executeHouseMacro, "Both")
            end
        end
    end
end)
