    ToggleBtn.Position = UDim2.new(1, -50, 0.5, -10)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    ToggleBtn.Text = ""
    ToggleBtn.AutoButtonColor = false
    ToggleBtn.Parent = Frame

    local ToggleCorner = Instance.new("UICorner")
    ToggleCorner.CornerRadius = UDim.new(1, 0)
    ToggleCorner.Parent = ToggleBtn

    local Circle = Instance.new("Frame")
    Circle.Size = UDim2.new(0, 16, 0, 16)
    Circle.Position = UDim2.new(0, 2, 0.5, -8)
    Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Circle.Parent = ToggleBtn

    local CircleCorner = Instance.new("UICorner")
    CircleCorner.CornerRadius = UDim.new(1, 0)
    CircleCorner.Parent = Circle

    local function UpdateVisuals()
        local isOn = Toggles[name]
        local targetColor = isOn and Color3.fromRGB(45, 200, 95) or Color3.fromRGB(70, 70, 70)
        local targetPos = isOn and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        
        TweenService:Create(ToggleBtn, TweenInfo.new(0.25), {BackgroundColor3 = targetColor}):Play()
        TweenService:Create(Circle, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetPos}):Play()
    end

    UpdateVisuals()

    ToggleBtn.MouseButton1Click:Connect(function()
        Toggles[name] = not Toggles[name]
        UpdateVisuals()
        
        -- Send Chat commands for No Sit & No Clip
        if name == "No Sit" then
            if Toggles[name] then SendChatMessage(";nosit") else SendChatMessage(";unnosit") end
        elseif name == "No Clip" then
            if Toggles[name] then SendChatMessage(";noclip") else SendChatMessage(";unnoclip") end
        end
    end)
end

