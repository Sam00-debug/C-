-- Populate List
local ADIDAS_TOP_ORDER = { "Adidas Sports", "Adidas Community", "Adidas Aura" }
local adidasRank = {}
for i, n in ipairs(ADIDAS_TOP_ORDER) do adidasRank[n] = i end
local allNames = {}
for name in pairs(PACKS) do table.insert(allNames, name) end

table.sort(allNames, function(a, b)
	local ra, rb = adidasRank[a], adidasRank[b]
	if ra and rb then return ra < rb end
	if ra then return true end
	if rb then return false end
	return a:lower() < b:lower() end
)

local buttonsByName = {}

local function createButton(name, order)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 42)
	btn.BackgroundColor3 = Theme.ButtonBg
	btn.TextColor3 = Theme.TextMain
	btn.Font = UiFont
	btn.TextSize = 14
	btn.Text = "   " .. (EMOJIS[name] or "✨") .. " " .. name
	btn.TextXAlignment = Enum.TextXAlignment.Left
	btn.AutoButtonColor = false -- Using custom tween
	btn.LayoutOrder = order
	btn.BorderSizePixel = 0
	btn.Parent = scroll
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
	
	-- Hover logic
	btn.MouseEnter:Connect(function() createTween(btn, {BackgroundColor3 = Theme.ButtonHover}) end)
	btn.MouseLeave:Connect(function() createTween(btn, {BackgroundColor3 = Theme.ButtonBg}) end)
	
	-- Click Animation & Execution
	btn.Activated:Connect(function()
		local t = createTween(btn, {Size = UDim2.new(1, -6, 0, 36)}, 0.1)
		t.Completed:Connect(function() createTween(btn, {Size = UDim2.new(1, 0, 0, 42)}, 0.1) end)
		
		local ok = applyPack(name)
		if ok then
			current.Text = "💎 Current: " .. name
			sendNotification("Equipped Pack!", "Successfully applied " .. name, EMOJIS[name])
		else
			current.Text = "❌ Failed: " .. name
			sendNotification("Error", "Failed to apply " .. name, "⚠️")
		end
	end)
	buttonsByName[name] = btn
end

for i, name in ipairs(allNames) do createButton(name, i) end
