local PACKS = {}

local function loadPacks()
	local success, result = pcall(function()
		return game:HttpGet(PACK_URL)
	end)

	if not success then
		warn("Failed to download AnimationPacks.json")
		return false
	end

	local ok, data = pcall(function()
		return HttpService:JSONDecode(result)
	end)

	if not ok or type(data) ~= "table" then
		warn("Invalid AnimationPacks.json")
		return false
	end

	PACKS = data

	print("Animation packs loaded:", #PACKS)
	return true
end

