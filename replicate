local function getCharacterPart(char: Model, index: number): BasePart?
    local isR15 = char:FindFirstChild("UpperTorso") ~= nil
    local rMap = isR15 and {
        [1]="UpperTorso", [2]="Head", [3]="LeftUpperArm", [4]="LeftLowerArm",
        [5]="RightUpperArm", [6]="RightLowerArm", [7]="LeftUpperLeg", [8]="LeftLowerLeg",
        [9]="RightUpperLeg", [10]="RightLowerLeg", [11]="LeftHand", [12]="RightHand",
        [13]="LowerTorso", [14]="LeftFoot", [15]="RightFoot"
    } or {
        [1]="Torso", [2]="Head", [3]="Left Arm", [4]="Left Arm",
        [5]="Right Arm", [6]="Right Arm", [7]="Left Leg", [8]="Left Leg",
        [9]="Left Leg", [10]="Right Leg", [11]="Right Leg", [12]="Torso",
        [13]="Torso", [14]="Torso", [15]="Torso"
    }
    return char:FindFirstChild(rMap[index] or (isR15 and "LowerTorso" or "Torso")) :: BasePart
end
local function updatePropsCache()
    table.clear(propsCache)
    local workspaceCom = workspace:FindFirstChild("WorkspaceCom")
    if workspaceCom then
        for _, folder in ipairs(workspaceCom:GetChildren()) do
            for _, child in ipairs(folder:GetChildren()) do
                if child.Name:sub(1, 4) == "Prop" and child.Name:find(lp.Name) then
                    table.insert(propsCache, child)
                end
            end
        end
    end
end
local function setAvatarVisibility(visible: boolean)
    local char = lp.Character
    if not char then return end
    for _, desc in pairs(char:GetDescendants()) do
        if desc:IsA("BasePart") and desc.Name ~= "HumanoidRootPart" then
            desc.LocalTransparencyModifier = visible and 0 or 1
        elseif desc:IsA("Decal") then
            desc.LocalTransparencyModifier = visible and 0 or 1
        end
    end
end
