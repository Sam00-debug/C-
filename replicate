            elseif rgbMode == "Shift" then
                if now - lastShift > 0.5 then
                    lastShift = now
                    local color = Color3.fromHSV(math.random(), 1, 1)
                    for _, prop in ipairs(propsCache) do for _, desc in ipairs(prop:GetDescendants()) do if desc:IsA("BasePart") then desc.Color = color end end end
                end
            elseif rgbMode == "Disco" then
                if now - lastShift > 0.2 then
                    lastShift = now
                    for _, prop in ipairs(propsCache) do
                        local color = Color3.fromHSV(math.random(), 1, 1)
                        for _, desc in ipairs(prop:GetDescendants()) do if desc:IsA("BasePart") then desc.Color = color end end
                    end
                end
            end
        end
        RunService.Heartbeat:Wait()
    end
end)
function startReplication()
    currentMechOrigin = nil 
    local nextNetworkUpdate = 0
    
    trackingConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if not activeTracking then return end
        
        local char = lp.Character
        local rootPart = char and char:FindFirstChild("HumanoidRootPart") :: BasePart
        local head = char and char:FindFirstChild("Head") :: BasePart
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        if char and rootPart and hum and head then
            local dynBackwardOffset = CFrame.new(BACKWARD_OFFSET_X, 0, BACKWARD_OFFSET_Z)
            -- Apply all 3 Rotations dynamically
            local dynPropRotation = CFrame.Angles(
                math.rad(PROP_ROTATION_X - 360), 
                math.rad(PROP_ROTATION_Y - 360), 
                math.rad(PROP_ROTATION_Z - 360)
            )

            if beRobotEnabled then
                local headProp = propsCache[2]
                if headProp then workspace.CurrentCamera.CameraSubject = headProp end
                hum.WalkSpeed = defaultUserWalkSpeed * SCALE_MULTIPLIER
                hum.JumpPower = defaultUserJumpPower * SCALE_MULTIPLIER
                hum.UseJumpPower = true
                hum.HipHeight = defaultUserHipHeight * SCALE_MULTIPLIER 
                workspace.Gravity = defaultGravity * SCALE_MULTIPLIER
            else
                workspace.CurrentCamera.CameraSubject = hum
                hum.WalkSpeed = defaultUserWalkSpeed
                hum.JumpPower = defaultUserJumpPower
                hum.HipHeight = defaultUserHipHeight
                workspace.Gravity = defaultGravity
            end

            local _, yaw, _ = rootPart.CFrame:ToEulerAnglesYXZ()
            local flatCFrame = CFrame.new(rootPart.Position) * CFrame.Angles(0, yaw, 0)
            local targetOriginFrame
            
          if beRobotEnabled then
    targetOriginFrame = flatCFrame * CFrame.new(0, MECH_HEIGHT_OFFSET, 0)
else
    targetOriginFrame = flatCFrame * dynBackwardOffset * CFrame.new(0, MECH_HEIGHT_OFFSET, 0)
end
            
            if not currentMechOrigin then 
                currentMechOrigin = targetOriginFrame 
            else
                currentMechOrigin = currentMechOrigin:Lerp(targetOriginFrame, FOLLOW_SMOOTHNESS)
            end
            
            local shouldNetworkUpdate = tick() >= nextNetworkUpdate
            if shouldNetworkUpdate then nextNetworkUpdate = tick() + 0.1 end
            for index, prop in ipairs(propsCache) do
                if index > 15 then break end
                local remote = prop:FindFirstChild("SetCurrentCFrame")
                local sourcePart = getCharacterPart(char, index)            
                if sourcePart then
                    local relativeTransform = rootPart.CFrame:ToObjectSpace(sourcePart.CFrame)
                    local scaledPosition = relativeTransform.Position * SCALE_MULTIPLIER
                    local scaledRelativeCFrame = CFrame.new(scaledPosition) * relativeTransform.Rotation
                    local finalPropCFrame = currentMechOrigin * scaledRelativeCFrame * dynPropRotation
                    
                    if prop.PrimaryPart then
                        prop:SetPrimaryPartCFrame(finalPropCFrame)
                    end                   
                    if shouldNetworkUpdate and remote and remote:IsA("RemoteFunction") then
                        task.spawn(function() pcall(function() remote:InvokeServer(finalPropCFrame) end) end)
                    end
                end
            end
        end
    end)
end
