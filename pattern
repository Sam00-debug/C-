-- --- CACHE SYSTEM (Optimized to prevent Workspace scanning lag) ---
local cachedProps = {}
local cachedPartsForRGB = {}
local lastCacheUpdate = 0
local CACHE_REFRESH_RATE = 0.5 -- Only scan workspace twice a second

local function updatePropsCache()
    local now = tick()
    if now - lastCacheUpdate < CACHE_REFRESH_RATE then return end
    lastCacheUpdate = now

    table.clear(cachedProps)
    table.clear(cachedPartsForRGB)

    local com = workspace:FindFirstChild("WorkspaceCom")
    if not com then return end

    for _, folder in ipairs(com:GetChildren()) do
        for _, child in ipairs(folder:GetChildren()) do
            if child.Name == "Prop" .. lp.Name then
                local remote = child:FindFirstChild("SetCurrentCFrame")
                if remote then
                    table.insert(cachedProps, {prop = child, remote = remote})
                    -- Cache parts for RGB instantly
                    for _, desc in ipairs(child:GetDescendants()) do
                        if desc:IsA("BasePart") then
                            table.insert(cachedPartsForRGB, desc)
                        end
                    end
                end
            end
        end
    end
end

