local function createSlider(name, min, max, defaultVal, parentFrame)
    local container = Instance.new("Frame", parentFrame or mainList)
    container.Size = UDim2.new(1, -10, 0, 28)
    container.BackgroundTransparency = 1
    container.LayoutOrder = getOrder()

    local label = Instance.new("TextLabel", container)
    label.Size = UDim2.new(1, 0, 0, 12)
    label.BackgroundTransparency = 1
    label.TextColor3 = Colors.Text
    label.Text = name .. ": " .. tostring(defaultVal)
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 8
    label.TextXAlignment = Enum.TextXAlignment.Left

    local bg = Instance.new("TextButton", container)
    bg.Size = UDim2.new(1, 0, 0, 6)
    bg.Position = UDim2.new(0, 0, 0, 16)
    bg.BackgroundColor3 = Colors.Surface
    bg.Text = ""
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 3)

    local fill = Instance.new("Frame", bg)
    fill.Size = UDim2.new((defaultVal - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Colors.Primary
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)

    local value = defaultVal
    local dragging = false
    local function update(input)
        local pos = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        value = m_floor(min + pos * (max - min))
        label.Text = name .. ": " .. tostring(value)
    end
    bg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; update(input) end
    end)
    bg.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
    end)
    return function() return value end
end

