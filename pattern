    for _, prop in ipairs(propsCache) do
        local remote = prop:FindFirstChild("SetCurrentCFrame")
        if remote then table.insert(data, {prop = prop, remote = remote}) end
    end
    return data
end

local function isItemAssigned(itemToCheck)
    for _, assignedItem in pairs(assignedItems) do
        if assignedItem.remote == itemToCheck.remote then return true end
    end
    return false
end

