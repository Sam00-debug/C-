local function getRevolveOffset(idx, totalProps, radius, localTime)
    local x, y, z = 0, 0, 0
    local pRatio = idx / totalProps
    local radRatio = pRatio * math.pi * 2

    if activeRevolve == "Spin" then
        x, z = math.cos(radRatio + localTime) * radius, math.sin(radRatio + localTime) * radius
    elseif activeRevolve == "Reverse Spin" then
        x, z = math.cos(radRatio - localTime) * radius, math.sin(radRatio - localTime) * radius
    elseif activeRevolve == "Bobbing Orbit" then
        x, z = math.cos(radRatio + localTime) * radius, math.sin(radRatio + localTime) * radius
        y = math.sin((localTime * 2) + radRatio) * (radius / 1.5)
    elseif activeRevolve == "Vertical Halo" then
        z = (radius / 1.5) + 2
        x, y = math.cos(radRatio + localTime) * radius, math.sin(radRatio + localTime) * radius
    elseif activeRevolve == "Back Chakra" then
        z = 3; x, y = math.cos(radRatio + localTime) * radius, math.sin(radRatio + localTime) * radius
    elseif activeRevolve == "Line Wise" then
        x = (idx - totalProps/2) * (radius/5)
        y = math.sin(localTime + idx) * (radius/3)
    elseif activeRevolve == "2 Ring" then
        local r2 = (idx % 2 == 0) and radius or radius/1.5
        local speedMult = (idx % 2 == 0) and 1 or -1
        x, z = math.cos(radRatio + (localTime * speedMult)) * r2, math.sin(radRatio + (localTime * speedMult)) * r2
    elseif activeRevolve == "3 Ring" then
        local ring = idx % 3
        local ang = radRatio + localTime
        if ring == 0 then x, z = math.cos(ang) * radius, math.sin(ang) * radius
        elseif ring == 1 then x, y = math.cos(ang) * radius, math.sin(ang) * radius
        else y, z = math.cos(ang) * radius, math.sin(ang) * radius end
    elseif activeRevolve == "Spiral" then
        local arm = (idx/totalProps) * math.pi * 4
        x, z = math.cos(arm + localTime) * radius, math.sin(arm + localTime) * radius
        y = ((totalProps - idx) - totalProps/2) * (radius/5)
    elseif activeRevolve == "Tornado" then
        local heightRatio = idx / totalProps
        local curRadius = radius * heightRatio
        y = (heightRatio * radius) - (radius / 2)
        x, z = math.cos(radRatio + localTime * 2) * curRadius, math.sin(radRatio + localTime * 2) * curRadius
    elseif activeRevolve == "Wheel" then
        x, y = math.cos(radRatio) * radius, math.sin(radRatio) * radius
        local rotAng = localTime
        local nx = x * math.cos(rotAng) - y * math.sin(rotAng)
        local ny = x * math.sin(rotAng) + y * math.cos(rotAng)
        x, y = nx, ny
    elseif activeRevolve == "Modern Spin" then
        x, z = math.cos(radRatio + localTime) * radius, math.sin(radRatio + localTime) * radius
        local tilt = math.rad(90)
        local ny = z * math.sin(tilt)
        z = z * math.cos(tilt)
        y = ny
    elseif activeRevolve == "Wave" then
        z = -radius + 2
        x = (idx - totalProps/2) * (radius/3)
        y = math.sin(localTime + x) * (radius/2)
    elseif activeRevolve == "Cross" then
        local arm = idx % 4
        local dist = (math.ceil(idx/4) / (totalProps/4)) * radius
        if arm == 0 then x = dist elseif arm == 1 then x = -dist elseif arm == 2 then z = dist else z = -dist end
    elseif activeRevolve == "Atom" then
        local ring = idx % 3; local ang = radRatio + localTime
        if ring == 0 then x, z = math.cos(ang)*radius, math.sin(ang)*radius
        elseif ring == 1 then x, y = math.cos(ang)*radius, math.sin(ang)*radius
        else y, z = math.cos(ang)*radius, math.sin(ang)*radius end
    elseif activeRevolve == "Galaxy Spiral" then
        local r = (idx / totalProps) * radius + (radius * 0.2)
        local sAng = (idx / totalProps) * math.pi * 2 + localTime
        if idx % 2 == 1 then sAng = sAng + math.pi end
        x, z = math.cos(sAng) * r, math.sin(sAng) * r
    elseif activeRevolve == "Crown" then
        y = (radius / 1.5) + 3
        x, z = math.cos(radRatio + localTime) * radius, math.sin(radRatio + localTime) * radius
        y = y + math.sin(radRatio) * (radius * 0.2)
    elseif activeRevolve == "DNA" then
        y = (idx - (totalProps/2)) * (radius/10)
        local phase = (idx % 2 == 0) and 0 or math.pi
        x, z = math.cos((idx * 0.5) + localTime + phase) * radius, math.sin((idx * 0.5) + localTime + phase) * radius
    elseif activeRevolve == "Wings" then
        local side = (idx % 2 == 0) and 1 or -1
        local iOff = math.ceil(idx / 2)
        x, y, z = side * (iOff * (radius/5)), iOff * (radius/10), iOff * (radius/5)
    elseif activeRevolve == "Discipline Army" then
        local cols = math.ceil(math.sqrt(totalProps))
        local col, row = (idx - 1) % cols, math.floor((idx - 1) / cols)
        x, z = (col - cols/2) * (radius/2), (row - cols/2) * (radius/2)
    elseif activeRevolve == "Flower" then
        local r = radius * math.cos(5 * radRatio + localTime)
        x, z = r * math.cos(radRatio), r * math.sin(radRatio)
    elseif activeRevolve == "Domain Expansion" then
        local phi = math.acos(1 - 2 * (idx / totalProps))
        local theta = math.sqrt(totalProps * math.pi) * phi + localTime
        x = radius * math.sin(phi) * math.cos(theta)
        y = radius * math.sin(phi) * math.sin(theta)
        z = radius * math.cos(phi)
    elseif activeRevolve == "Snake Body" then
        x, z = math.sin(localTime - (idx * 0.2)) * radius, (idx * (radius/5))
    end
    
    return Vector3.new(x, y, z)
end

local function getRotateCFrame(idx, radius, localTime)
    local cf = CFrame.new()
    if activeRotate == "Normal Rotate" then cf = CFrame.Angles(0, localTime * 2, 0)
    elseif activeRotate == "Up Down" then cf = CFrame.new(0, math.sin(localTime * 4) * (radius/3), 0)
    elseif activeRotate == "Wave" then cf = CFrame.new(0, math.sin(localTime * 4 + (idx%2 == 0 and 0 or math.pi)) * (radius/3), 0)
    elseif activeRotate == "Side to Side" then cf = CFrame.new(0, 0, math.sin(localTime * 4) * (radius/3))
    elseif activeRotate == "Side Wave" then cf = CFrame.new(0, 0, math.sin(localTime * 4 + (idx%2 == 0 and 0 or math.pi)) * (radius/3))
    elseif activeRotate == "Glitchy" then cf = CFrame.new(math.random(-1,1)*(radius/10), math.random(-1,1)*(radius/10), math.random(-1,1)*(radius/10)) * CFrame.Angles(math.random(), math.random(), math.random())
    elseif activeRotate == "Tilt Axis" then cf = CFrame.Angles(localTime * 2, 0, 0)
    elseif activeRotate == "Roll Axis" then cf = CFrame.Angles(0, 0, localTime * 2)
    elseif activeRotate == "Chaos" then cf = CFrame.Angles(localTime * 3, localTime * 2.5, localTime * 3.5)
    elseif activeRotate == "Heartbeat" then cf = CFrame.new(0, 0, (math.sin(localTime * 8) > 0.8 and radius/2 or 0))
    elseif activeRotate == "Nodding" then cf = CFrame.Angles(math.sin(localTime * 4), 0, 0)
    elseif activeRotate == "Shaking" then cf = CFrame.Angles(0, math.sin(localTime * 8), 0)
    elseif activeRotate == "Orbit Self" then cf = CFrame.Angles(0, localTime * 5, 0)
    elseif activeRotate == "Propeller" then cf = CFrame.Angles(0, 0, localTime * 5)
    elseif activeRotate == "Pendulum" then cf = CFrame.Angles(0, 0, math.sin(localTime * 3)) * CFrame.new(0, -radius/4, 0)
    elseif activeRotate == "Breathing" then cf = CFrame.new(0, 0, math.sin(localTime * 2) * (radius/4))
    elseif activeRotate == "Tremor" then cf = CFrame.new(math.sin(localTime*20)*0.5, 0, math.cos(localTime*20)*0.5)
    elseif activeRotate == "Flipping" then cf = CFrame.Angles(localTime * 4, 0, 0)
    elseif activeRotate == "Bounce" then cf = CFrame.new(0, math.abs(math.sin(localTime * 4)) * (radius/2), 0)
    elseif activeRotate == "ZigZag" then cf = CFrame.new(0, (localTime * 5 % 2) - 1, (localTime * 3 % 2) - 1)
    elseif activeRotate == "Spiral Self" then cf = CFrame.new(0, math.sin(localTime*3)*(radius/4), 0) * CFrame.Angles(0, localTime * 4, 0)
    end
    return cf
end

local function getRobotOffset(localIdx, globalToggle)
    local t = (localIdx % 2 == 0) and not globalToggle or globalToggle
    local flip = CFrame.Angles(0, math.pi, 0)
    
    if localIdx == 1 then
        local off = t and CFrame.new(0, -4, 1.8) or CFrame.new(0, -4, -0.5)
        return off * flip
    elseif localIdx == 2 then
        local off = t and CFrame.new(-1.5, -4, -2.5) or CFrame.new(1.5, -4, -2.5)
        return off 
    elseif localIdx == 3 then
        local off = t and CFrame.new(0, -1, -3.5) or CFrame.new(0, -1, -1.5)
        return off 
    elseif localIdx == 4 then
        local off = t and CFrame.new(3, -4, 0) or CFrame.new(1.5, -4, 0)
        return off * CFrame.Angles(0, -math.pi/2, 0)
    elseif localIdx == 5 then
        local off = t and CFrame.new(-3, -4, 0) or CFrame.new(-1.5, -4, 0)
        return off * CFrame.Angles(0, -math.pi/2, 0)
    else
        local dynamicAngle = (localIdx * math.pi * 2) / 7 
        local dynamicDist = t and 3.5 or 1.5
        local x = math.sin(dynamicAngle) * dynamicDist
        local z = math.cos(dynamicAngle) * dynamicDist
        local y = -4 + ((localIdx % 4) * 1.2)
        local pos = Vector3.new(x, y, z)
        return CFrame.lookAt(pos, Vector3.new(0, y, 0)) * flip
    end
end

