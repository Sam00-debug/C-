-- --- MATH GEOMETRY ENGINE (Optimized) ---
local function getRevolveOffset(idx, totalProps, radius, localTime)
    local x, y, z = 0, 0, 0
    local pRatio = idx / totalProps
    local radRatio = pRatio * m_pi * 2

    if activeRevolve == "Spin" then x, z = m_cos(radRatio + localTime) * radius, m_sin(radRatio + localTime) * radius
    elseif activeRevolve == "Reverse Spin" then x, z = m_cos(radRatio - localTime) * radius, m_sin(radRatio - localTime) * radius
    elseif activeRevolve == "Bobbing Orbit" then x, z = m_cos(radRatio + localTime) * radius, m_sin(radRatio + localTime) * radius; y = m_sin((localTime * 2) + radRatio) * (radius / 1.5)
    elseif activeRevolve == "Vertical Halo" then z = (radius / 1.5) + 2; x, y = m_cos(radRatio + localTime) * radius, m_sin(radRatio + localTime) * radius
    elseif activeRevolve == "Back Chakra" then z = 3; x, y = m_cos(radRatio + localTime) * radius, m_sin(radRatio + localTime) * radius
    elseif activeRevolve == "Line Wise" then x = (idx - totalProps/2) * (radius/5); y = m_sin(localTime + idx) * (radius/3)
    elseif activeRevolve == "2 Ring" then
        local r2 = (idx % 2 == 0) and radius or radius/1.5
        local speedMult = (idx % 2 == 0) and 1 or -1
        x, z = m_cos(radRatio + (localTime * speedMult)) * r2, m_sin(radRatio + (localTime * speedMult)) * r2
    elseif activeRevolve == "3 Ring" then
        local ring, ang = idx % 3, radRatio + localTime
        if ring == 0 then x, z = m_cos(ang) * radius, m_sin(ang) * radius elseif ring == 1 then x, y = m_cos(ang) * radius, m_sin(ang) * radius else y, z = m_cos(ang) * radius, m_sin(ang) * radius end
    elseif activeRevolve == "Spiral" then
        local arm = (idx/totalProps) * m_pi * 4
        x, z = m_cos(arm + localTime) * radius, m_sin(arm + localTime) * radius
        y = ((totalProps - idx) - totalProps/2) * (radius/5)
    elseif activeRevolve == "Tornado" then
        local curRadius = radius * pRatio
        y = (pRatio * radius) - (radius / 2)
        x, z = m_cos(radRatio + localTime * 2) * curRadius, m_sin(radRatio + localTime * 2) * curRadius
    elseif activeRevolve == "Wheel" then
        x, y = m_cos(radRatio) * radius, m_sin(radRatio) * radius
        x, y = x * m_cos(localTime) - y * m_sin(localTime), x * m_sin(localTime) + y * m_cos(localTime)
    elseif activeRevolve == "Modern Spin" then
        x, z = m_cos(radRatio + localTime) * radius, m_sin(radRatio + localTime) * radius
        local tilt = m_rad(90); z, y = z * m_cos(tilt), z * m_sin(tilt)
    elseif activeRevolve == "Wave" then z = -radius + 2; x = (idx - totalProps/2) * (radius/3); y = m_sin(localTime + x) * (radius/2)
    elseif activeRevolve == "Cross" then
        local arm, dist = idx % 4, (m_ceil(idx/4) / (totalProps/4)) * radius
        if arm == 0 then x = dist elseif arm == 1 then x = -dist elseif arm == 2 then z = dist else z = -dist end
    elseif activeRevolve == "Atom" then
        local ring, ang = idx % 3, radRatio + localTime
        if ring == 0 then x, z = m_cos(ang)*radius, m_sin(ang)*radius elseif ring == 1 then x, y = m_cos(ang)*radius, m_sin(ang)*radius else y, z = m_cos(ang)*radius, m_sin(ang)*radius end
    elseif activeRevolve == "Galaxy Spiral" then
        local r, sAng = pRatio * radius + (radius * 0.2), pRatio * m_pi * 2 + localTime
        if idx % 2 == 1 then sAng = sAng + m_pi end
        x, z = m_cos(sAng) * r, m_sin(sAng) * r
    elseif activeRevolve == "Crown" then
        y = (radius / 1.5) + 3; x, z = m_cos(radRatio + localTime) * radius, m_sin(radRatio + localTime) * radius
        y = y + m_sin(radRatio) * (radius * 0.2)
    elseif activeRevolve == "DNA" then
        local phase = (idx % 2 == 0) and 0 or m_pi
        y = (idx - (totalProps/2)) * (radius/10); x, z = m_cos((idx * 0.5) + localTime + phase) * radius, m_sin((idx * 0.5) + localTime + phase) * radius
    elseif activeRevolve == "Wings" then
        local side, iOff = (idx % 2 == 0) and 1 or -1, m_ceil(idx / 2)
        x, y, z = side * (iOff * (radius/5)), iOff * (radius/10), iOff * (radius/5)
    elseif activeRevolve == "Discipline Army" then
        local cols = m_ceil(m_sqrt(totalProps))
        local col, row = (idx - 1) % cols, m_floor((idx - 1) / cols)
        x, z = (col - cols/2) * (radius/2), (row - cols/2) * (radius/2)
    elseif activeRevolve == "Flower" then
        local r = radius * m_cos(5 * radRatio + localTime)
        x, z = r * m_cos(radRatio), r * m_sin(radRatio)
    elseif activeRevolve == "Domain Expansion" then
        local phi, theta = m_acos(1 - 2 * pRatio), m_sqrt(totalProps * m_pi) * phi + localTime
        x, y, z = radius * m_sin(phi) * m_cos(theta), radius * m_sin(phi) * m_sin(theta), radius * m_cos(phi)
    elseif activeRevolve == "Snake Body" then x, z = m_sin(localTime - (idx * 0.2)) * radius, (idx * (radius/5)) end
    
    return Vector3.new(x, y, z)
end

local function getRotateCFrame(idx, radius, localTime)
    if activeRotate == "Normal Rotate" then return CFrame.Angles(0, localTime * 2, 0)
    elseif activeRotate == "Up Down" then return CFrame.new(0, m_sin(localTime * 4) * (radius/3), 0)
    elseif activeRotate == "Wave" then return CFrame.new(0, m_sin(localTime * 4 + (idx%2 == 0 and 0 or m_pi)) * (radius/3), 0)
    elseif activeRotate == "Side to Side" then return CFrame.new(0, 0, m_sin(localTime * 4) * (radius/3))
    elseif activeRotate == "Side Wave" then return CFrame.new(0, 0, m_sin(localTime * 4 + (idx%2 == 0 and 0 or m_pi)) * (radius/3))
    elseif activeRotate == "Glitchy" then return CFrame.new(math.random(-1,1)*(radius/10), math.random(-1,1)*(radius/10), math.random(-1,1)*(radius/10)) * CFrame.Angles(math.random(), math.random(), math.random())
    elseif activeRotate == "Tilt Axis" then return CFrame.Angles(localTime * 2, 0, 0)
    elseif activeRotate == "Roll Axis" then return CFrame.Angles(0, 0, localTime * 2)
    elseif activeRotate == "Chaos" then return CFrame.Angles(localTime * 3, localTime * 2.5, localTime * 3.5)
    elseif activeRotate == "Heartbeat" then return CFrame.new(0, 0, (m_sin(localTime * 8) > 0.8 and radius/2 or 0))
    elseif activeRotate == "Nodding" then return CFrame.Angles(m_sin(localTime * 4), 0, 0)
    elseif activeRotate == "Shaking" then return CFrame.Angles(0, m_sin(localTime * 8), 0)
    elseif activeRotate == "Orbit Self" then return CFrame.Angles(0, localTime * 5, 0)
    elseif activeRotate == "Propeller" then return CFrame.Angles(0, 0, localTime * 5)
    elseif activeRotate == "Pendulum" then return CFrame.Angles(0, 0, m_sin(localTime * 3)) * CFrame.new(0, -radius/4, 0)
    elseif activeRotate == "Breathing" then return CFrame.new(0, 0, m_sin(localTime * 2) * (radius/4))
    elseif activeRotate == "Tremor" then return CFrame.new(m_sin(localTime*20)*0.5, 0, m_cos(localTime*20)*0.5)
    elseif activeRotate == "Flipping" then return CFrame.Angles(localTime * 4, 0, 0)
    elseif activeRotate == "Bounce" then return CFrame.new(0, m_abs(m_sin(localTime * 4)) * (radius/2), 0)
    elseif activeRotate == "ZigZag" then return CFrame.new(0, (localTime * 5 % 2) - 1, (localTime * 3 % 2) - 1)
    elseif activeRotate == "Spiral Self" then return CFrame.new(0, m_sin(localTime*3)*(radius/4), 0) * CFrame.Angles(0, localTime * 4, 0)
    end
    return CFrame.new()
end

local function getRobotOffset(localIdx, globalToggle)
    local t, flip = (localIdx % 2 == 0) and not globalToggle or globalToggle, CFrame.Angles(0, m_pi, 0)
    if localIdx == 1 then return (t and CFrame.new(0, -4, 1.8) or CFrame.new(0, -4, -0.5)) * flip
    elseif localIdx == 2 then return t and CFrame.new(-1.5, -4, -2.5) or CFrame.new(1.5, -4, -2.5)
    elseif localIdx == 3 then return t and CFrame.new(0, -1, -3.5) or CFrame.new(0, -1, -1.5)
    elseif localIdx == 4 then return (t and CFrame.new(3, -4, 0) or CFrame.new(1.5, -4, 0)) * CFrame.Angles(0, -m_pi/2, 0)
    elseif localIdx == 5 then return (t and CFrame.new(-3, -4, 0) or CFrame.new(-1.5, -4, 0)) * CFrame.Angles(0, -m_pi/2, 0)
    else
        local dAng, dDist = (localIdx * m_pi * 2) / 7, t and 3.5 or 1.5
        local y = -4 + ((localIdx % 4) * 1.2)
        local pos = Vector3.new(m_sin(dAng) * dDist, y, m_cos(dAng) * dDist)
        return CFrame.lookAt(pos, Vector3.new(0, y, 0)) * flip
    end
end

-- --- MASTER EXECUTION LOOP ---
RunService.Heartbeat:Connect(function(dt)
    if rgbMode ~= "OFF" and #cachedPartsForRGB > 0 then
        local now, hueSpeed = tick(), 0.5 * dt
        if rgbMode == "Dyna" then
            local hue = (now * 0.2) % 1
            local c = Color3.fromHSV(hue, 1, 1)
            for i = 1, #cachedPartsForRGB do cachedPartsForRGB[i].Color = c end
        elseif rgbMode == "Shift" then
            local c = Color3.fromHSV((m_floor(now * 2) / 2) % 1, 1, 1)
            for i = 1, #cachedPartsForRGB do cachedPartsForRGB[i].Color = c end
        elseif rgbMode == "Disco" then
            for i = 1, #cachedPartsForRGB do 
                if m_floor(now * 10) % 3 == 0 then cachedPartsForRGB[i].Color = Color3.fromHSV(math.random(), 1, 1) end
            end
        end
    end

    if activeMode == "None" then return end
    updatePropsCache()

    if #cachedProps == 0 then
        if tick() - lastStartTick > 3 then
            activeMode = "None"
            sendNotif("System", "No props exist. Stopped automatically.", 3)
        end
        return
    end

    local targetList = {}
    for plr, _ in pairs(selectedPlayers) do
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") then
            table.insert(targetList, plr)
        end
    end

    local tCount = #targetList
    if tCount == 0 then return end

    local now = tick()
    local doNetworkUpdate = false
    if (now - lastNetworkUpdate) >= NETWORK_RATE then lastNetworkUpdate = now; doNetworkUpdate = true end

    -- Centralized lockedProp logic for AutoDuplicate modes
    if activeMode == "Robot" or activeMode == "Chair" then
        if not lockedProp or not lockedProp.Parent then lockedProp = cachedProps[1].prop end
        if lockedProp and lockedProp.Parent then
            pcall(function() lockedProp:PivotTo(CFrame.new(LOCKED_PROP_POSITION)) end)
            -- Single, clean duplication loop
            if now - lastAutoDuplicate >= AUTO_DUPLICATE_INTERVAL then
                lastAutoDuplicate = now
                local dupRemote = lockedProp:FindFirstChild("DuplicateProp")
                if dupRemote then
                    for i = 1, 14 do
                        task.spawn(function() pcall(function() dupRemote:InvokeServer() end) end)
                    end
                end
            end
        end
    else
        lockedProp = nil
    end

    if activeMode == "Orbit" then
        local radius, speed, cY = getRadius(), getSpeed() / 100, getCenterY()
        local rX, rY, rZ = m_rad(getRotX()), m_rad(getRotY()), m_rad(getRotZ())
        angle = angle + (speed * (dt * 60)) -- smooth orbit regardless of framerate

        for idx, item in ipairs(cachedProps) do
            local targetIdx = ((idx - 1) % tCount) + 1
            local tRoot = targetList[targetIdx].Character.HumanoidRootPart
            local propsForThisTarget = m_ceil(#cachedProps / tCount)
            local localIdx = idx % propsForThisTarget

            local revOffset = getRevolveOffset(localIdx, propsForThisTarget, radius, angle)
            local rotCFrame = getRotateCFrame(localIdx, radius, angle)
            local centerOffset = CFrame.new(0, cY, 0) * CFrame.Angles(rX, rY, rZ)
            
            local calcCFrame = (tRoot.CFrame * centerOffset) * CFrame.new(revOffset) * rotCFrame
            
            pcall(function() item.prop:PivotTo(calcCFrame) end)
            if doNetworkUpdate then task.spawn(function() pcall(function() item.remote:InvokeServer(calcCFrame) end) end) end
        end

    elseif activeMode == "Robot" then
        if (now - lastRobotTick) >= ROBOT_RATE then
            lastRobotTick, robotSwitchToggle = now, not robotSwitchToggle
            for tIdx, plr in ipairs(targetList) do
                local tRoot = plr.Character.HumanoidRootPart
                local predictedCF = tRoot.CFrame + (tRoot.AssemblyLinearVelocity * PREDICTION_FACTOR)
                
                local propsPerTarget = m_floor(#cachedProps / tCount)
                if propsPerTarget == 0 then propsPerTarget = 1 end
                local startIdx = ((tIdx - 1) * propsPerTarget) + 1
                local endIdx = (tIdx == tCount) and #cachedProps or (tIdx * propsPerTarget)
                
                local localIdx = 1
                for i = startIdx, endIdx do
                    local item = cachedProps[i]
                    if item and item.prop ~= lockedProp then
                        local finalCFrame
                        if tCount < 6 then
                            local phi, theta = m_acos(1 - 2 * (localIdx / propsPerTarget)), m_pi * (1 + m_sqrt(5)) * localIdx
                            local rMult = 2 + m_sin(now * 100 * ((localIdx % 2 == 0) and 2 or 1)) * 2
                            local pos = predictedCF.Position + Vector3.new(rMult * m_sin(phi) * m_cos(theta), rMult * m_sin(phi) * m_sin(theta), rMult * m_cos(phi))
                            finalCFrame = CFrame.lookAt(pos, predictedCF.Position) * CFrame.Angles(0, m_pi, 0)
                        else
                            finalCFrame = predictedCF * getRobotOffset(localIdx, robotSwitchToggle)
                        end
                        task.spawn(function() pcall(function() item.remote:InvokeServer(finalCFrame) end) end)
                        localIdx = localIdx + 1
                    end
                end
            end
        end

    elseif activeMode == "Chair" then
        local assignedTracker = {}
        for _, plr in ipairs(targetList) do
            local char = plr.Character
            local tRoot, humanoid = char.HumanoidRootPart, char.Humanoid
            
            voidedPlayers[plr] = (tRoot.Position.Y < -500)
            local myItem = assignedItems[plr]
            
            if not myItem or not myItem.prop.Parent then
                for _, rItem in ipairs(cachedProps) do
                    if rItem.prop ~= lockedProp and not assignedTracker[rItem.remote] then
                        myItem = rItem; assignedItems[plr] = rItem; break
                    end
                end
            end
            
            if myItem then
                assignedTracker[myItem.remote] = true
                if not voidedPlayers[plr] then
                    task.spawn(function()
                        pcall(function()
                            myItem.remote:InvokeServer(humanoid.Sit and CFrame.new(tRoot.Position.X, -1000, tRoot.Position.Z) or (tRoot.CFrame * CFrame.new(0, -2.5, 0)))
                        end)
                    end)
                end
            end
        end
    end
end)
