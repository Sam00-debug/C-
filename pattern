-- --- MASTER EXECUTION LOOP ---
RunService.Heartbeat:Connect(function()
    if activeMode == "None" then return end

    local propsData = getAvailablePropsData()
    
    if #propsData == 0 then
        if tick() - lastStartTick > 3 then
            activeMode = "None"
            assignedItems = {}
            voidedPlayers = {}
            sendNotif("System", "No props exist. Stopped logic automatically.", 3)
        end
        return
    end

    local tCount = 0
    local targetList = {}
    for plr, _ in pairs(selectedPlayers) do
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") then
            table.insert(targetList, plr)
            tCount = tCount + 1
        end
    end

    if tCount == 0 then return end

    local now = tick()
    local doNetworkUpdate = false
    if (now - lastNetworkUpdate) >= NETWORK_RATE then
        lastNetworkUpdate = now
        doNetworkUpdate = true
    end
        
    if activeMode == "Orbit" then
        local radius = getRadius()
        local speed = getSpeed() / 100
        local cY = getCenterY()
        local rX, rY, rZ = math.rad(getRotX()), math.rad(getRotY()), math.rad(getRotZ())
        
        angle = angle + speed

        for idx, item in ipairs(propsData) do
            local targetIdx = ((idx - 1) % tCount) + 1
            local tRoot = targetList[targetIdx].Character.HumanoidRootPart
            local propsForThisTarget = math.ceil(#propsData / tCount)
            local localIdx = idx % propsForThisTarget

            local revOffset = getRevolveOffset(localIdx, propsForThisTarget, radius, angle)
            local rotCFrame = getRotateCFrame(localIdx, radius, angle)
            
            local centerOffset = CFrame.new(0, cY, 0) * CFrame.Angles(rX, rY, rZ)
            local baseCFrame = tRoot.CFrame * centerOffset
            local calcCFrame = baseCFrame * CFrame.new(revOffset) * rotCFrame
            
            pcall(function() item.prop:PivotTo(calcCFrame) end)
            if doNetworkUpdate then
                task.spawn(function() pcall(function() item.remote:InvokeServer(calcCFrame) end) end)
            end
        end

    elseif activeMode == "Robot" then
        if (now - lastRobotTick) >= ROBOT_RATE then
            lastRobotTick = now
            robotSwitchToggle = not robotSwitchToggle
            
            for tIdx, plr in ipairs(targetList) do
                local tRoot = plr.Character.HumanoidRootPart
                
                -- Velocity offset prediction (+15 studs ahead math based on speed)
                local velocity = tRoot.AssemblyLinearVelocity
                local predictedCF = tRoot.CFrame + (velocity * PREDICTION_FACTOR)
                
                local propsPerTarget = math.floor(#propsData / tCount)
                if propsPerTarget == 0 then propsPerTarget = 1 end
                local startIdx = ((tIdx - 1) * propsPerTarget) + 1
                local endIdx = (tIdx == tCount) and #propsData or (tIdx * propsPerTarget)
                
                local localIdx = 1
                for i = startIdx, endIdx do
                    local item = propsData[i]
                    if item then
                        local finalCFrame
                        
                        -- Target logic based on amount selected
                        if tCount < 6 then
                            -- Fibonacci Spherical Distribution 
                            local phi = math.acos(1 - 2 * (localIdx / propsPerTarget))
                            local theta = math.pi * (1 + math.sqrt(5)) * localIdx
                            
                            -- Half at 2x speed, half at 1x
                            local speedMult = (localIdx % 2 == 0) and 2 or 1
                            
                            -- Forward / Backward pulsing oscillation
                            local oscillation = math.sin(now * 100 * speedMult) * 2
                            local radius = 2 + oscillation
                            
                            local x = radius * math.sin(phi) * math.cos(theta)
                            local y = radius * math.sin(phi) * math.sin(theta)
                            local z = radius * math.cos(phi)
                            
                            local pos = predictedCF.Position + Vector3.new(x, y, z)
                            
                            -- Focus on target root part, flipping 180 degrees to look at the player correctly
                            finalCFrame = CFrame.lookAt(pos, predictedCF.Position) * CFrame.Angles(0, math.pi, 0)
                        else
                            -- Traditional distributed robot logic
                            local offsetCFrame = getRobotOffset(localIdx, robotSwitchToggle)
                            finalCFrame = predictedCF * offsetCFrame
                        end
                        
                        task.spawn(function() pcall(function() item.remote:InvokeServer(finalCFrame) end) end)
                        
                        localIdx = localIdx + 1
                    end
                end
            end
        end

    elseif activeMode == "Chair" then
        for _, plr in ipairs(targetList) do
            local char = plr.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                local tRoot = char.HumanoidRootPart
                local humanoid = char.Humanoid
                
                -- Check if target is already successfully voided
                if tRoot.Position.Y < -500 then
                    voidedPlayers[plr] = true
                else
                    voidedPlayers[plr] = false
                end
                
                -- Ensure exactly ONE prop is assigned per target
                local myItem = assignedItems[plr]
                if not myItem or not myItem.prop.Parent then
                    for _, rItem in ipairs(propsData) do
                        if not isItemAssigned(rItem) then
                            myItem = rItem
                            assignedItems[plr] = rItem
                            break
                        end
                    end
                end
                
                if myItem then
                    -- If condition is false (they are not voided yet), execute the loop process
                    if not voidedPlayers[plr] then
                        task.spawn(function()
                            pcall(function()
                                if humanoid.Sit then
                                    -- Target is sitting! Teleport the prop into the void to drag them down
                                    myItem.remote:InvokeServer(CFrame.new(tRoot.Position.X, -1000, tRoot.Position.Z))
                                else
                                    -- Target is not sitting yet, keep teleporting the prop to their legs
                                    -- Offset ~2.5 studs down from HumanoidRootPart to target the legs universally (R6 & R15)
                                    local legCF = tRoot.CFrame * CFrame.new(0, -2.5, 0)
                                    myItem.remote:InvokeServer(legCF)
                                end
                            end)
                        end)
                    end
                    -- If voidedPlayers[plr] is true, the script does nothing with the prop (stopping it) 
                    -- until the target resets or moves back above Y = -500.
                end
            end
        end
    end
end)

