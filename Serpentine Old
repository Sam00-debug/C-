local function createButton(parent, text, isToggle, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.fromScale(0.9, 0.08)
    btn.BackgroundColor3 = Color3.fromRGB(35, 45, 35)
    btn.Text = isToggle and text.." : OFF" or text
    btn.TextColor3 = Color3.fromRGB(220,220,220)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextScaled = true
    Instance.new("UICorner",btn).CornerRadius = UDim.new(0.2, 0)
    local padding = Instance.new("UIPadding", btn)
    padding.PaddingTop = UDim.new(0.2,0)
    padding.PaddingBottom = UDim.new(0.2,0)

    local state = false
    btn.MouseButton1Click:Connect(function()
        playClickSound()
        if isToggle then
            state = not state
            btn.Text = text .. (state and " : ON" or " : OFF")
            btn.BackgroundColor3 = state and Color3.fromRGB(50, 200, 100) or Color3.fromRGB(35, 45, 35)
            btn.TextColor3 = state and Color3.fromRGB(0,0,0) or Color3.fromRGB(220,220,220)
        end
        callback(state, btn)
    end)
    return btn
end

