local function updatePropsCache()
    table.clear(propsCache)
    local workspaceCom = workspace:FindFirstChild("WorkspaceCom")
    if workspaceCom then
        for _, folder in ipairs(workspaceCom:GetChildren()) do
            for _, child in ipairs(folder:GetChildren()) do
                if child.Name:sub(1, 4) == "Prop" and child.Name:find(lp.Name) then
                    table.insert(propsCache, child)
                end
            end
        end
    end
end

local function setAvatarVisibility(visible: boolean)
    local char = lp.Character
    if not char then return end
    for _, desc in pairs(char:GetDescendants()) do
        if desc:IsA("BasePart") and desc.Name ~= "HumanoidRootPart" then
            desc.LocalTransparencyModifier = visible and 0 or 1
        elseif desc:IsA("Decal") then
            desc.LocalTransparencyModifier = visible and 0 or 1
        end
    end
end

