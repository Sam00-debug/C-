-- Helper: Slider
local function createSlider(parent, text, yPos, min, max, default, isFloat, callback)
    local label = Instance.new("TextLabel", parent)
    label.Size = UDim2.new(1, -30, 0, 20)
    label.Position = UDim2.new(0, 15, 0, yPos)
    label.BackgroundTransparency = 1
    label.Text = text .. ": " .. tostring(default)
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    
    local track = createFrame(parent, UDim2.new(1, -30, 0, 8), UDim2.new(0, 15, 0, yPos + 22), Color3.fromRGB(15, 15, 18), 4)
    local fill = createFrame(track, UDim2.new((default - min)/(max - min), 0, 1, 0), UDim2.new(0, 0, 0, 0), Color3.fromRGB(100, 100, 220), 4)
    
    local dragging = false
    local function updateSlider(input)
        local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        local val = min + (max - min) * pos
        if not isFloat then val = math.floor(val) else val = math.floor(val * 100) / 100 end
        label.Text = text .. ": " .. tostring(val)
        callback(val)
    end
    
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; updateSlider(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(input)
        end
    end)
end

