local function cleanUp()
    state.isRunning = false
    for _, conn in ipairs(state.connections) do
        if conn.Connected then conn:Disconnect() end
    end
    table.clear(state.connections)
    
    if state.currentTrack then
        state.currentTrack:Stop()
        state.currentTrack = nil
    end
    
    local char = lp.Character
    if char then
        local animateScript = char:FindFirstChild("Animate")
        if animateScript then animateScript.Disabled = false end
    end
end

-- --- LOGIC ---
local function applyEmote()
    local char = lp.Character
    if not char then return end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 2)
    local animateScript = char:FindFirstChild("Animate")

    if animateScript then animateScript.Disabled = true end
    
    for _, t in pairs(animator:GetPlayingAnimationTracks()) do
        t:Stop(0.1)
    end

    local success, objects = pcall(function() 
        return game:GetObjects("rbxassetid://" .. animId) 
    end)

    local animation
    if success and objects[1] and objects[1]:IsA("Animation") then
        animation = objects[1]
    else
        animation = Instance.new("Animation")
        animation.AnimationId = "rbxassetid://" .. animId
    end

    state.currentTrack = animator:LoadAnimation(animation)
    state.currentTrack.Priority = Enum.AnimationPriority.Action4
    state.currentTrack.Looped = true
    state.currentTrack:Play()
    state.currentTrack:AdjustSpeed(state.emoteSpeed)
end

local function stopEmote()
    if state.currentTrack then
        state.currentTrack:Stop(0.1)
        state.currentTrack = nil
    end
    local char = lp.Character
    if char then
        local animateScript = char:FindFirstChild("Animate")
        if animateScript then animateScript.Disabled = false end
    end
end

