local function toggleEmote(shouldPlay)
    if not char or not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 2)
    local animateScript = char:FindFirstChild("Animate")

    if shouldPlay then
        if animateScript then animateScript.Disabled = true end
        
        for _, t in pairs(animator:GetPlayingAnimationTracks()) do
            t:Stop(0.1)
        end

        local success, objects = pcall(function() 
            return game:GetObjects("rbxassetid://" .. animId) 
        end)

        local animation
        if success and objects[1] and objects[1]:IsA("Animation") then
            animation = objects[1]
        else
            animation = Instance.new("Animation")
            animation.AnimationId = "rbxassetid://" .. animId
        end

        currentTrack = animator:LoadAnimation(animation)
        currentTrack.Priority = Enum.AnimationPriority.Action4
        currentTrack.Looped = true
        currentTrack:Play()
        currentTrack:AdjustSpeed(emoteSpeed)
    else
        if currentTrack then
            currentTrack:Stop(0.1)
            currentTrack = nil
        end
        if animateScript then animateScript.Disabled = false end
    end
end

local function bindCharacter(c)
    char = c
    root = char:WaitForChild("HumanoidRootPart", 3)
    hum = char:WaitForChild("Humanoid", 3)
    
    if running then
        task.wait(0.5) -- Wait for load
        toggleEmote(true)
    end
end

