local function createFrame(parent, size, pos, color, radius)
    local f = Instance.new("Frame", parent)
    f.Size = size
    f.Position = pos
    f.BackgroundColor3 = color
    f.BorderSizePixel = 0
    if radius > 0 then
        local corner = Instance.new("UICorner", f)
        corner.CornerRadius = UDim.new(0, radius)
    end
    return f
end

