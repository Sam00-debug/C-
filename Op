-- Populate Player List
local function populatePlayers()
    for _, child in ipairs(playerList:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    local excludedUsers = {
        Nothing_sam00 = true,
        Kausarali2 = true,
        mob_one00 = true,
        cutie143198 = true
    }
    local ySize = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp and not excludedUsers[plr.Name] then
            local btnFrame = Instance.new("Frame", playerList)
            btnFrame.Size = UDim2.new(1, 0, 0, 40)
            btnFrame.BackgroundColor3 = table.find(selectedTargets, plr) and Color3.fromRGB(80, 120, 180) or Color3.fromRGB(45, 45, 55)
            MakeCorner(btnFrame, 6)
            
            local btn = Instance.new("TextButton", btnFrame)
            btn.Size = UDim2.new(1,0,1,0)
            btn.BackgroundTransparency = 1
            btn.Text = ""
            
            local dName = Instance.new("TextLabel", btnFrame)
            dName.Size = UDim2.new(1, -10, 0, 20)
            dName.Position = UDim2.new(0, 10, 0, 2)
            dName.BackgroundTransparency = 1
            dName.Text = plr.DisplayName
            dName.TextColor3 = Color3.fromRGB(255, 255, 255)
            dName.Font = Enum.Font.GothamBold
            dName.TextSize = 14
            dName.TextXAlignment = Enum.TextXAlignment.Left
            
            local uName = Instance.new("TextLabel", btnFrame)
            uName.Size = UDim2.new(1, -10, 0, 16)
            uName.Position = UDim2.new(0, 10, 0, 20)
            uName.BackgroundTransparency = 1
            uName.Text = "@" .. plr.Name
            uName.TextColor3 = Color3.fromRGB(180, 180, 180)
            uName.Font = Enum.Font.Gotham
            uName.TextSize = 11
            uName.TextXAlignment = Enum.TextXAlignment.Left

            table.insert(connections, btn.MouseButton1Click:Connect(function()
                local idx = table.find(selectedTargets, plr)
                if idx then
                    table.remove(selectedTargets, idx)
                    btnFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
                else
                    table.insert(selectedTargets, plr)
                    btnFrame.BackgroundColor3 = Color3.fromRGB(80, 120, 180)
                end
                selectTargetsBtn.Text = "Select Targets (" .. #selectedTargets .. ")"
            end))
            ySize = ySize + 45
        end
    end
    playerList.CanvasSize = UDim2.new(0, 0, 0, ySize)
end


