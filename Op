table.insert(state.connections, RunService.Stepped:Connect(function()
    if not state.isRunning then return end
    
    local char = lp.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.Sit = false end
        
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end))

table.insert(state.connections, RunService.Heartbeat:Connect(function()
    if not state.isRunning or #state.selectedTargets == 0 then return end
    
    if tick() - state.lastSwitchTime >= state.switchInterval then
        state.currentTargetIndex = state.currentTargetIndex + 1
        if state.currentTargetIndex > #state.selectedTargets then
            state.currentTargetIndex = 1
        end
        state.lastSwitchTime = tick()
    end
    
    local targetPlr = state.selectedTargets[state.currentTargetIndex]
    if not targetPlr then return end
    
    local tChar = targetPlr.Character
    local char = lp.Character
    
    if tChar and char then
        local tHead = tChar:FindFirstChild("Head")
        local tRoot = tChar:FindFirstChild("HumanoidRootPart")
        local root = char:FindFirstChild("HumanoidRootPart")
        
        if tHead and tRoot and root then
            if state.positionMode == "Front" then
                root.CFrame = tHead.CFrame * CFrame.new(0, 0.4, -1.2) * CFrame.Angles(0, math.pi, 0)
            else
                root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 1.2)
            end
            
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end
end))
