-- ==========================================
-- PHYSICS & TELEPORT LOOP
-- ==========================================

-- Removing Collisions and Sit property seamlessly so we don't glitch or bounce off the target
table.insert(connections, RunService.Stepped:Connect(function()
    if running and char then
        if hum then hum.Sit = false end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end))

table.insert(connections, RunService.Heartbeat:Connect(function()
    if running and #selectedTargets > 0 and root then
        -- Handle Interval Switching
        if #selectedTargets > 1 and tick() - lastSwitchTime >= switchInterval then
            currentTargetIndex = currentTargetIndex + 1
            if currentTargetIndex > #selectedTargets then currentTargetIndex = 1 end
            lastSwitchTime = tick()
        end
        
        -- Get Active Target
        local target = selectedTargets[currentTargetIndex]
        if not target then return end

        local tChar = target.Character
        if tChar then
            local tHead = tChar:FindFirstChild("Head")
            local tHum = tChar:FindFirstChild("Humanoid")
            
            if tHead and tHum and tHum.Health > 0 then
                local headOffset = (tHum.RigType == Enum.HumanoidRigType.R15) and 0.5 or 0.3
                
                -- Teleport Math based on mode
                if positionMode == "Front" then
                    -- Slightly above, little forward, 180 rotated
                    root.CFrame = tHead.CFrame * CFrame.new(0, headOffset, -1.2) * CFrame.Angles(0, math.pi, 0)
                else
                    -- Behind, no 180 rotation, exact head level
                    root.CFrame = tHead.CFrame * CFrame.new(0, 0, 1.2)
                end
                
                -- Kill velocity to stop flinging
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end
end))

-- ==========================================
-- CLEAN KILL SYSTEM
-- ==========================================
killBtn.MouseButton1Click:Connect(function()
    running = false
    toggleEmote(false)
    
    -- Restore Collisions
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
    
    -- Disconnect all events
    for _, connection in ipairs(connections) do
        if connection then connection:Disconnect() end
    end
    
    gui:Destroy()
end)
