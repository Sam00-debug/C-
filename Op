local function getPlayerHouse()
    local lots = workspace:FindFirstChild("001_Lots")
    if not lots then return nil end
    local house = lots:FindFirstChild(lp.Name .. "House") or lots:FindFirstChild(lp.Name .. " House")
    if house and house:FindFirstChild("HousePickedByPlayer") and house.HousePickedByPlayer:FindFirstChild("HouseModel") then
        return house
    end
    return nil
end

local function getClosestManualPosition(houseFolder)
    -- loaded part in your house to identify which lot you are at
    local samplePart = houseFolder:FindFirstChildWhichIsA("BasePart", true)
    if not samplePart then return nil end
    
    local samplePos = samplePart.Position
    local closestPos = manualPositions[1]
    local minDistance = math.huge
    
    for _, pos in ipairs(manualPositions) do
        local dist = (samplePos - pos).Magnitude
        if dist < minDistance then
            minDistance = dist
            closestPos = pos
        end
    end
    
    return closestPos
end

antibangBtn.MouseButton1Click:Connect(function()
    local character = lp.Character
    if isActionActive or not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    -- 1. Verify house is spawned
    local houseFolder = getPlayerHouse()
    if not houseFolder then
        StarterGui:SetCore("SendNotification", {
            Title = "Anti troll 🤖",
            Text = "Spawn a House First 🏠",
            Duration = 5 -- Lowered from 40 so UI won't get stuck
        })
        return 
    end 
    
    -- 2. Get the closest manual coordinate to your house
    local targetPosition = getClosestManualPosition(houseFolder)
    if not targetPosition then return end

    isActionActive = true

    -- Detect "Piggyback" Friends via Welds/Motor6Ds to avoid banning them
    local protectedVictims = {}
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("Weld") or obj:IsA("Motor6D") or obj:IsA("WeldConstraint") then
            -- Check both parts attached to the weld to see if they belong to another player's character
            for _, part in ipairs({obj.Part0, obj.Part1}) do
                if part and part.Parent and part.Parent ~= character and part.Parent:FindFirstChild("Humanoid") then
                    local vicPlayer = Players:GetPlayerFromCharacter(part.Parent)
                    if vicPlayer then
                        protectedVictims[vicPlayer] = true
                    end
                end
            end
        end
    end

    local rootPart = character.HumanoidRootPart
    local originalCFrame = rootPart.CFrame

    -- 3. Teleport to your manual house position
    rootPart.CFrame = CFrame.new(targetPosition + Vector3.new(0, 2, 0))

    -- 4. Wait exactly 1 second
    task.wait(1)

    local houseModel = houseFolder.HousePickedByPlayer.HouseModel
    local clearPropsRemote = houseModel:FindFirstChild("Permissions:ClearProps")
    local disallowRemote = houseModel:FindFirstChild("Permissions:Disallow")

    -- 5. Prop delete remote event
    if clearPropsRemote then
        task.spawn(function()
            pcall(function()
                clearPropsRemote:InvokeServer()
            end)
        end)
    end

    -- 6. Ban all remote event (excluding piggybacked friends)
    if disallowRemote then
        for _, target in pairs(Players:GetPlayers()) do
            if target ~= lp and not protectedVictims[target] then
                pcall(function() disallowRemote:FireServer(target) end)
            end
        end
    end

    -- 7. Wait exactly 0.2 seconds
    task.wait(0.2)

    -- 8. Spawn back to original position
    rootPart.CFrame = originalCFrame

    isActionActive = false
end)

