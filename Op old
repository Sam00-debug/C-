-- --- Teleportation Loop ---
RunService.PostSimulation:Connect(function()
    if running and selectedPlayer and selectedPlayer.Character and root then
        local tChar = selectedPlayer.Character
        local tHead = tChar:FindFirstChild("Head")
        local tHum = tChar:FindFirstChild("Humanoid")
        
        if tHead and tHum then
            local headOffset = (tHum.RigType == Enum.HumanoidRigType.R15) and 0.5 or 0.3
            root.CFrame = tHead.CFrame * CFrame.new(0, headOffset, -1) * CFrame.Angles(0, math.pi, 0)
            
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end
end)
