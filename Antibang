-- BUTTON 1: OP ANTIBANG
-- ==========================================
opAntibangBtn.MouseButton1Click:Connect(function()
    if isActionActive or not character:FindFirstChild("HumanoidRootPart") then return end
    isActionActive = true
    isAcrobaticsActive = true
    
    local rootPart = character.HumanoidRootPart
    local originalCFrame = rootPart.CFrame
    local camera = workspace.CurrentCamera
    
    local CircleCenter = (originalCFrame * CFrame.new(0, 0, 500)).Position
    
    local lockedCamCFrame = camera.CFrame
    camera.CameraType = Enum.CameraType.Scriptable
    camera.CFrame = lockedCamCFrame
    
    highSpeedDash(CFrame.new(CircleCenter))
    
    local timeElapsed = 0
    local sequenceDuration = 4
    local emoteTimer = 0.5 
    
    local currentPos = CircleCenter
    local BilliardSpeed = 15
    local SpinSpeed = 10
    local CircleRadius = 2
    local velocity = Vector3.new(1, 0, 0.7).Unit * BilliardSpeed 
    local currentRotation = 0
    
    LoadTrack(EmotID)
    
    local connection
    connection = RunService.Heartbeat:Connect(function(dt)
        if not character or not character:FindFirstChild("HumanoidRootPart") then
            if connection then connection:Disconnect() end
            return
        end
        
        timeElapsed += dt
        emoteTimer += dt
        
        if emoteTimer >= 0.5 then
            emoteTimer = 0
            if CurrentTrack then
                CurrentTrack:Stop() 
                CurrentTrack:Play(0, 1, Settings.Speed)
            end
        end
        
        currentPos = currentPos + (velocity * dt)
        local offsetXZ = Vector3.new(currentPos.X - CircleCenter.X, 0, currentPos.Z - CircleCenter.Z)
        
        if offsetXZ.Magnitude >= CircleRadius then
            local normal = offsetXZ.Unit
            currentPos = CircleCenter + normal * CircleRadius 
            
            local vXZ = Vector3.new(velocity.X, 0, velocity.Z)
            local dotProduct = vXZ:Dot(normal)
            local reflected = vXZ - (2 * dotProduct * normal)
            velocity = Vector3.new(reflected.X, 0, reflected.Z)
        end
        
        currentRotation += SpinSpeed * dt
        rootPart.CFrame = CFrame.new(currentPos) * CFrame.Angles(0, currentRotation, 0)
    end)
    
    task.wait(sequenceDuration)
    if connection then connection:Disconnect() end
    if CurrentTrack then
        CurrentTrack:Stop()
        CurrentTrack = nil
    end
    
    highSpeedDash(originalCFrame)
    task.wait(0.2)
    setCharacterCollision(true)
    camera.CameraType = Enum.CameraType.Custom
    
    isAcrobaticsActive = false
    isActionActive = false
end)

