local function GetPlayerHouse()
    local lotFolder = workspace:FindFirstChild("001_Lots")
    if lotFolder then
        for _, house in pairs(lotFolder:GetChildren()) do
            local owner = house:FindFirstChild("HousePickedByPlayer")
            if owner and owner.Value == LocalPlayer.Name then return house end
        end
    end
    return nil
end

