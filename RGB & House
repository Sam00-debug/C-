local function CreateSlider(text, min, max)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, 0, 0, 60)
    Frame.BackgroundColor3 = Theme.Section
    Frame.Parent = ScrollFrame
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -30, 0, 25)
    Label.Position = UDim2.new(0, 15, 0, 5)
    Label.BackgroundTransparency = 1
    Label.Text = text .. ": " .. tostring(State.RGBDelay)
    Label.TextColor3 = Theme.Text
    Label.TextSize = 14
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame

    local SliderBG = Instance.new("TextButton")
    SliderBG.Size = UDim2.new(1, -30, 0, 6)
    SliderBG.Position = UDim2.new(0, 15, 0, 40)
    SliderBG.BackgroundColor3 = Theme.ToggleOff
    SliderBG.Text = ""
    SliderBG.Parent = Frame
    Instance.new("UICorner", SliderBG).CornerRadius = UDim.new(1, 0)

    local Fill = Instance.new("Frame")
    -- Initialize Fill Size based on global state
    local relStart = math.clamp((State.RGBDelay - min) / (max - min), 0, 1)
    Fill.Size = UDim2.new(relStart, 0, 1, 0)
    Fill.BackgroundColor3 = Theme.Accent
    Fill.Parent = SliderBG
    Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

    local Dot = Instance.new("Frame")
    Dot.Size = UDim2.new(0, 14, 0, 14)
    Dot.Position = UDim2.new(1, -7, 0.5, -7)
    Dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Dot.Parent = Fill
    Instance.new("UICorner", Dot).CornerRadius = UDim.new(1, 0)

    local sDragging = false
    local function update(input)
        local relPos = math.clamp((input.Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0, 1)
        Fill.Size = UDim2.new(relPos, 0, 1, 0)
        local value = min + (max - min) * relPos
        value = math.floor(value * 10) / 10
        State.RGBDelay = value
        Label.Text = text .. ": " .. tostring(value)
    end

    SliderBG.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sDragging = true; update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sDragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if sDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
end

