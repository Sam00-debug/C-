-- [[ Background Logic Loop ]] --
-- Only start if it's not already running globally
if not State.LogicRunning then
    State.LogicRunning = true
    task.spawn(function()
        local colorIndex = 1
        while task.wait(State.RGBDelay) do
            
            local currentColor = Color3.new(1, 1, 1)
            local currentSkin = "Institutional white"
            
            if State.CurrentColorMode == "Switch" then
                currentColor = CycleColors[colorIndex]
                currentSkin = SkinColors[colorIndex]
                colorIndex = colorIndex % #CycleColors + 1
            elseif State.CurrentColorMode == "Dynamic" then
                currentColor = Color3.fromHSV((tick() % 5) / 5, 1, 1)
                currentSkin = SkinColors[colorIndex]
                colorIndex = colorIndex % #SkinColors + 1
            elseif State.CurrentColorMode == "Disco" then
                currentColor = Color3.new(math.random(), math.random(), math.random())
                currentSkin = SkinColors[math.random(1, #SkinColors)]
            end
            
            -- Read off of global `State.Toggles` instead of local `Toggles`
            if State.Toggles.RGBName then pcall(function() ReplicatedStorage.RE["1RPNam1eColo1r"]:FireServer("PickingRPNameColor", currentColor) end) end
            if State.Toggles.RGBBio then pcall(function() ReplicatedStorage.RE["1RPNam1eColo1r"]:FireServer("PickingRPBioColor", currentColor) end) end
            if State.Toggles.RGBHouseName then pcall(function() ReplicatedStorage.RE["1RPHous1eEven1tColo1r"]:FireServer("PickingBusinessNameColor", currentColor) end) end
            if State.Toggles.RGBHoverboard then pcall(function() LocalPlayer.PlayerGui.MainGUIHandler.NoMotorVehicleControl.NoMotorColorPicks.SetColor:FireServer(currentColor) end) end
            if State.Toggles.RGBMusicBox then pcall(function() LocalPlayer.PlayerGui.ToolGui.ToolSettings.Settings.PropsColor.SetColor:FireServer(currentColor) end) end
            if State.Toggles.RGBSkin then pcall(function() ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ChangeBodyColor"):FireServer(currentSkin) end) end
            if State.Toggles.RGBHouse then pcall(function() LocalPlayer.PlayerGui.MainGUIHandler.HouseControlPanel.HouseColorPicker.SetColor:FireServer(currentColor) end) end
            if State.Toggles.LoopWindows then pcall(function() ReplicatedStorage.RE["1Player1sHous1e"]:FireServer("Curtains") end) end
        end
    end)
end
