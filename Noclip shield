local manualPositions = {
    Vector3.new(288, 5, 209), Vector3.new(257, 5, 278), Vector3.new(288, 22, 209), Vector3.new(257, 22, 278),
    Vector3.new(-21, 35, 445), Vector3.new(151, 36, 459), Vector3.new(234, 37, 463), Vector3.new(255, 35, 373),
