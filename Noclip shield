    Vector3.new(-456, 35, -224), Vector3.new(-453, 35, -318), Vector3.new(-356, 35, -313), Vector3.new(-194, 35, -313),
    Vector3.new(-424, 68, -446), Vector3.new(-353, 68, -510), Vector3.new(-38, 10, 2240),
