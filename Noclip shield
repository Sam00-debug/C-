    circleCorner.Parent = switchCircle

    local active = false
    switchBg.MouseButton1Click:Connect(function()
        active = not active
        toggles[name] = active
        
        local targetColor = active and Color3.fromRGB(40, 200, 80) or Color3.fromRGB(80, 80, 80)
        local targetPos = active and UDim2.fromScale(0.5, 0.1) or UDim2.fromScale(0.05, 0.1)
        
