-- ==========================================
-- OPTIMIZED COLLISION LOGIC (BEST PRACTICE)
-- ==========================================
local cachedBypassParts = {}

local function checkAndCachePart(part)
    if part:IsA("BasePart") then
        local nameLower = part.Name:lower()
        if nameLower:find("soccer") or nameLower:find("ball") or nameLower:find("door") or nameLower:find("vehicle") or nameLower:find("car") then
            cachedBypassParts[part] = true
        end
    end
end

-- Pre-scan existing parts
for _, obj in pairs(Workspace:GetDescendants()) do
    checkAndCachePart(obj)
end

-- Listen for new parts seamlessly
Workspace.DescendantAdded:Connect(checkAndCachePart)
Workspace.DescendantRemoving:Connect(function(obj)
    cachedBypassParts[obj] = nil
end)

-- Continuous collision override (Stepped is best for physics override)
RunService.Stepped:Connect(function()
    if toggles.NoCollision then
        for part in pairs(cachedBypassParts) do
            if part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

