local function getPlayerHouse()
    local lots = Workspace:FindFirstChild("001_Lots")
    if not lots then return nil end
    local house = lots:FindFirstChild(player.Name .. "House") or lots:FindFirstChild(player.Name .. " House")
    if house and house:FindFirstChild("HousePickedByPlayer") and house.HousePickedByPlayer:FindFirstChild("HouseModel") then
        return house
    end
    return nil
end

local function triggerHouseBanProtocol()
    if isActionActive or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local houseFolder = getPlayerHouse()
    if not houseFolder then
        StarterGui:SetCore("SendNotification", {
            Title = "Anti-Bang Triggered",
            Text = "Please spawn a House to enable ban logic! 🏠",
            Duration = 5
        })
        return
    end
    
    local samplePart = houseFolder:FindFirstChildWhichIsA("BasePart", true)
    if not samplePart then return end
    local samplePos = samplePart.Position
    local closestPos = manualPositions[1]
    local minDistance = math.huge
    
    for _, pos in ipairs(manualPositions) do
        local dist = (samplePos - pos).Magnitude
        if dist < minDistance then
            minDistance = dist
            closestPos = pos
        end
    end

    isActionActive = true
    local rootPart = character.HumanoidRootPart
    local originalCFrame = rootPart.CFrame

    -- TP to House
    rootPart.CFrame = CFrame.new(closestPos + Vector3.new(0, 2, 0))
    task.wait(1)

    local houseModel = houseFolder.HousePickedByPlayer.HouseModel
    local clearPropsRemote = houseModel:FindFirstChild("Permissions:ClearProps")
    local disallowRemote = houseModel:FindFirstChild("Permissions:Disallow")

    if clearPropsRemote then
        pcall(function() clearPropsRemote:InvokeServer() end)
    end

    if disallowRemote then
        for _, target in pairs(Players:GetPlayers()) do
            if target ~= player then
                pcall(function() disallowRemote:FireServer(target) end)
            end
        end
    end

    task.wait(0.2)
    -- TP Back
    rootPart.CFrame = originalCFrame
    isActionActive = false
end

-- ==========================================
-- PROXIMITY ANTI-BANG LOOP (2 SECONDS)
-- ==========================================
RunService.Heartbeat:Connect(function(dt)
    if toggles.AntiBang and character and character:FindFirstChild("HumanoidRootPart") then
        local root = character.HumanoidRootPart
        
        for _, otherPlayer in pairs(Players:GetPlayers()) do
            if otherPlayer ~= player and otherPlayer.Character and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local otherRoot = otherPlayer.Character.HumanoidRootPart
                local distance = (otherRoot.Position - root.Position).Magnitude
                
                -- Threshold is 3 studs for attached/following players
                if distance < 3 then
                    proximityTimers[otherPlayer.UserId] = (proximityTimers[otherPlayer.UserId] or 0) + dt
                    
                    if proximityTimers[otherPlayer.UserId] >= 2 then
                        proximityTimers[otherPlayer.UserId] = 0 -- Reset timer after triggering
                        task.spawn(triggerHouseBanProtocol)
                    end
                else
                    -- Reset timer if they move away
                    proximityTimers[otherPlayer.UserId] = 0
                end
            end
        end
    end
end)
