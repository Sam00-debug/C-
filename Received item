local function createSectionHeader(text)
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -4, 0, 28)
    Label.BackgroundTransparency = 1
    Label.Text = string.upper(text)
    Label.Font = Enum.Font.GothamBold
    Label.TextColor3 = Theme.TextDim
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = ScrollFrame
end

local function createButton(text, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -4, 0, 38)
    Btn.BackgroundColor3 = Theme.ButtonBG
    Btn.Text = text
    Btn.Font = Enum.Font.GothamSemibold
    Btn.TextColor3 = Theme.Text
    Btn.TextSize = 14
    Btn.AutoButtonColor = false
    Btn.Parent = ScrollFrame

    Instance.new("UICorner", Btn).CornerRadius = Theme.RadiusInner
    applyHoverAnimation(Btn, Theme.ButtonBG, Theme.ButtonHover)

    Btn.MouseButton1Click:Connect(function()
        -- Click effect
        local clickTween = TweenService:Create(Btn, tweenInfo(0.1), {Size = UDim2.new(1, -12, 0, 34)})
        clickTween:Play()
        clickTween.Completed:Wait()
        TweenService:Create(Btn, tweenInfo(0.2), {Size = UDim2.new(1, -4, 0, 38)}):Play()
        callback()
    end)
    return Btn
end

local function createToggle(text, callback)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, -4, 0, 42)
    Frame.BackgroundColor3 = Theme.ElementBG
    Frame.Parent = ScrollFrame
    Instance.new("UICorner", Frame).CornerRadius = Theme.RadiusInner

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -70, 1, 0)
    Label.Position = UDim2.new(0, 15, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.Font = Enum.Font.GothamSemibold
    Label.TextColor3 = Theme.Text
    Label.TextSize = 14
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame

    -- Professional iOS-style Toggle Switch
    local SwitchBtn = Instance.new("TextButton")
    SwitchBtn.Size = UDim2.new(0, 44, 0, 24)
    SwitchBtn.Position = UDim2.new(1, -55, 0.5, -12)
    SwitchBtn.BackgroundColor3 = Theme.ToggleOff
    SwitchBtn.Text = ""
    SwitchBtn.AutoButtonColor = false
    SwitchBtn.Parent = Frame
    Instance.new("UICorner", SwitchBtn).CornerRadius = UDim.new(1, 0)

    local Indicator = Instance.new("Frame")
    Indicator.Size = UDim2.new(0, 20, 0, 20)
    Indicator.Position = UDim2.new(0, 2, 0.5, -10)
    Indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Indicator.Parent = SwitchBtn
    Instance.new("UICorner", Indicator).CornerRadius = UDim.new(1, 0)

    local isToggled = false
    SwitchBtn.MouseButton1Click:Connect(function()
        isToggled = not isToggled
        local targetColor = isToggled and Theme.ToggleOn or Theme.ToggleOff
        local targetPos = isToggled and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
        
        TweenService:Create(SwitchBtn, tweenInfo(0.3), {BackgroundColor3 = targetColor}):Play()
        TweenService:Create(Indicator, tweenInfo(0.3), {Position = targetPos}):Play()
        
        callback(isToggled)
    end)
end

