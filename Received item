-- 3. Tween Helpers
local function tweenInfo(time)
    return TweenInfo.new(time, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
end

local function applyHoverAnimation(button, originalColor, hoverColor)
    button.MouseEnter:Connect(function()
        TweenService:Create(button, tweenInfo(0.3), {BackgroundColor3 = hoverColor}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, tweenInfo(0.3), {BackgroundColor3 = originalColor}):Play()
    end)
end

