-- Slider Component (Fires command ONLY when user releases drag)
local function CreateSlider(commandName, minVal, maxVal, defaultVal)
	local Container = Instance.new("Frame")
	Container.Size = UDim2.new(1, 0, 0, 50)
	Container.BackgroundColor3 = Color3.fromRGB(26, 26, 32)
	Container.BorderSizePixel = 0
	Container.Parent = ScrollFrame

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0.18, 0)
	Corner.Parent = Container

	local TitleLabel = Instance.new("TextLabel")
	TitleLabel.Size = UDim2.new(0.6, 0, 0, 20)
	TitleLabel.Position = UDim2.new(0.04, 0, 0.12, 0)
	TitleLabel.BackgroundTransparency = 1
	TitleLabel.Text = commandName:sub(1,1):upper() .. commandName:sub(2)
	TitleLabel.TextColor3 = Color3.fromRGB(220, 220, 230)
	TitleLabel.Font = Enum.Font.GothamSemibold
	TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
	TitleLabel.Parent = Container
	ApplyTextScaling(TitleLabel, 13)

	local ValueLabel = Instance.new("TextLabel")
	ValueLabel.Size = UDim2.new(0.3, 0, 0, 20)
	ValueLabel.Position = UDim2.new(0.66, 0, 0.12, 0)
	ValueLabel.BackgroundTransparency = 1
	ValueLabel.Text = tostring(defaultVal)
	ValueLabel.TextColor3 = Color3.fromRGB(100, 220, 120)
	ValueLabel.Font = Enum.Font.GothamBold
	ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
	ValueLabel.Parent = Container
	ApplyTextScaling(ValueLabel, 13)

	local Track = Instance.new("Frame")
	Track.Size = UDim2.new(0.92, 0, 0, 6)
	Track.Position = UDim2.new(0.04, 0, 0.68, 0)
	Track.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
	Track.BorderSizePixel = 0
	Track.Parent = Container

	local TrackCorner = Instance.new("UICorner")
	TrackCorner.CornerRadius = UDim.new(1, 0)
	TrackCorner.Parent = Track

	local Fill = Instance.new("Frame")
	local initialScale = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)
	Fill.Size = UDim2.new(initialScale, 0, 1, 0)
	Fill.BackgroundColor3 = Color3.fromRGB(100, 220, 120)
	Fill.BorderSizePixel = 0
	Fill.Parent = Track

	local FillCorner = Instance.new("UICorner")
	FillCorner.CornerRadius = UDim.new(1, 0)
	FillCorner.Parent = Fill

	local isDragging = false

	local function UpdateSlider(input)
		local posX = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
		Fill.Size = UDim2.new(posX, 0, 1, 0)
		local currentVal = math.floor(minVal + (maxVal - minVal) * posX)
		ValueLabel.Text = tostring(currentVal)
		return currentVal
	end

	Container.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = true
			UpdateSlider(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			UpdateSlider(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if isDragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			isDragging = false
			local finalVal = tonumber(ValueLabel.Text)
			sendCommand(";" .. commandName:lower() .. " " .. tostring(finalVal))
		end
	end)
end

