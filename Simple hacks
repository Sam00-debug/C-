	local StatusText = Instance.new("TextLabel")
	StatusText.Size = UDim2.new(1, 0, 1, 0)
	StatusText.BackgroundTransparency = 1
	StatusText.Text = "OFF"
	StatusText.TextColor3 = Color3.fromRGB(150, 150, 160)
	StatusText.Font = Enum.Font.GothamBold
	StatusText.Parent = StatusBadge
	ApplyTextScaling(StatusText, 11)

	local toggled = false
	ToggleBtn.MouseButton1Click:Connect(function()
		toggled = not toggled
		if toggled then
			StatusBadge.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
			StatusText.Text = "ON"
			StatusText.TextColor3 = Color3.fromRGB(255, 255, 255)
			sendCommand(";" .. (onOverride or commandName:lower()))
		else
			StatusBadge.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
			StatusText.Text = "OFF"
			StatusText.TextColor3 = Color3.fromRGB(150, 150, 160)
			
			if offOverride then
				sendCommand(";" .. offOverride)
			else
				sendCommand(";un" .. commandName:lower())
			end
		end
	end)
end

