	Container.BorderSizePixel = 0
	Container.Parent = ScrollFrame

	local ContainerCorner = Instance.new("UICorner")
	ContainerCorner.CornerRadius = UDim.new(0.15, 0)
	ContainerCorner.Parent = Container

	local ToggleBtn = Instance.new("TextButton")
	ToggleBtn.Size = UDim2.new(0.63, 0, 0.8, 0)
	ToggleBtn.Position = UDim2.new(0.02, 0, 0.1, 0)
	ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	ToggleBtn.Text = commandName:upper() .. " [OFF]"
	ToggleBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
	ToggleBtn.Font = Enum.Font.GothamBold
	ToggleBtn.BorderSizePixel = 0
	ToggleBtn.Parent = Container
	ApplyTextScaling(ToggleBtn, 14)

	local ToggleCorner = Instance.new("UICorner")
	ToggleCorner.CornerRadius = UDim.new(0.15, 0)
	ToggleCorner.Parent = ToggleBtn

	local InputBox = Instance.new("TextBox")
	InputBox.Size = UDim2.new(0.31, 0, 0.8, 0)
	InputBox.Position = UDim2.new(0.67, 0, 0.1, 0)
	InputBox.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	InputBox.TextColor3 = Color3.fromRGB(220, 220, 220)
	InputBox.PlaceholderText = "Val"
	InputBox.Text = ""
	InputBox.Font = Enum.Font.Gotham
	InputBox.BorderSizePixel = 0
	InputBox.Parent = Container
	ApplyTextScaling(InputBox, 14)

	local InputCorner = Instance.new("UICorner")
	InputCorner.CornerRadius = UDim.new(0.15, 0)
	InputCorner.Parent = InputBox

	local toggled = false
	ToggleBtn.MouseButton1Click:Connect(function()
		toggled = not toggled
		if toggled then
			ToggleBtn.Text = commandName:upper() .. " [ON]"
			ToggleBtn.BackgroundColor3 = Color3.fromRGB(80, 200, 80)
			local val = InputBox.Text ~= "" and InputBox.Text or "1"
			sendCommand(";" .. commandName .. " " .. val)
		else
			ToggleBtn.Text = commandName:upper() .. " [OFF]"
			ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
			
			-- Check for default values to prevent using ";unspeed"
			if defaultValues[commandName:lower()] then
				sendCommand(";" .. commandName .. " " .. defaultValues[commandName:lower()])
			else
				sendCommand(";un" .. commandName)
			end
		end
	end)
end

local function CreateSimpleToggle(commandName, onOverride, offOverride)
	local ToggleBtn = Instance.new("TextButton")
	ToggleBtn.Size = UDim2.new(1, 0, 0, 42)
	ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	ToggleBtn.Text = commandName:upper() .. " [OFF]"
	ToggleBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
	ToggleBtn.Font = Enum.Font.GothamBold
	ToggleBtn.BorderSizePixel = 0
	ToggleBtn.Parent = ScrollFrame
	ApplyTextScaling(ToggleBtn, 14)

	local ToggleCorner = Instance.new("UICorner")
	ToggleCorner.CornerRadius = UDim.new(0.15, 0)
	ToggleCorner.Parent = ToggleBtn

	local toggled = false
	ToggleBtn.MouseButton1Click:Connect(function()
		toggled = not toggled
		if toggled then
			ToggleBtn.Text = commandName:upper() .. " [ON]"
			ToggleBtn.BackgroundColor3 = Color3.fromRGB(80, 200, 80)
			sendCommand(";" .. (onOverride or commandName))
		else
			ToggleBtn.Text = commandName:upper() .. " [OFF]"
			ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
			
			if offOverride then
				sendCommand(";" .. offOverride)
			elseif defaultValues[commandName:lower()] then
				sendCommand(";" .. commandName .. " " .. defaultValues[commandName:lower()])
			else
				sendCommand(";un" .. commandName)
			end
		end
	end)
end

local function CreatePlayerToggle(commandName, customPrefix)
	local ToggleBtn = Instance.new("TextButton")
	ToggleBtn.Size = UDim2.new(1, 0, 0, 42)
	ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	ToggleBtn.Text = commandName:upper() .. " [OFF]"
	ToggleBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
	ToggleBtn.Font = Enum.Font.GothamBold
	ToggleBtn.BorderSizePixel = 0
	ToggleBtn.Parent = ScrollFrame
	ApplyTextScaling(ToggleBtn, 14)

	local ToggleCorner = Instance.new("UICorner")
	ToggleCorner.CornerRadius = UDim.new(0.15, 0)
	ToggleCorner.Parent = ToggleBtn

	local toggled = false
	ToggleBtn.MouseButton1Click:Connect(function()
		toggled = not toggled
		local target = selectedTargetPlayer
		if toggled then
			ToggleBtn.Text = commandName:upper() .. " [ON]"
			ToggleBtn.BackgroundColor3 = Color3.fromRGB(80, 200, 80)
			
			if customPrefix then
				sendCommand(";" .. customPrefix .. " " .. target)
			else
				sendCommand(";" .. commandName .. " " .. target)
			end
		else
			ToggleBtn.Text = commandName:upper() .. " [OFF]"
			ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
			
			if customPrefix then
				sendCommand(";un" .. customPrefix .. " " .. target)
			else
				sendCommand(";un" .. commandName .. " " .. target)
			end
		end
	end)
end

