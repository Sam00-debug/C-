		local ok = applyPack(name)
		if ok then
			current.Text = "✨ Current: " .. name
			SendNotification("Equipped Pack!", "Applied " .. name .. " animation", true)
		else
			SendNotification("Error", "Failed to apply " .. name, false)
		end
	end)
	
	if not isReset then
		buttonsByName[name] = btn
	end
end

