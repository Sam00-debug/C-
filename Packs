	end)

	if not success or not Description then

		Status.Text = "Failed to get avatar"
		return

	end

	-- Main animations

	local Walk = Description.WalkAnimation
	local Run = Description.RunAnimation
	local Jump = Description.JumpAnimation
	local Fall = Description.FallAnimation
	local Climb = Description.ClimbAnimation
	local Swim = Description.SwimAnimation
	local Idle = Description.IdleAnimation

	-- Animate script

	local Animate = Character:FindFirstChild("Animate")

	local Animation1 =
		getAnimateId(Animate, "idle", "Animation1")

	local Animation2 =
		getAnimateId(Animate, "idle", "Animation2")

	local SwimIdle =
		getAnimateId(Animate, "swimidle", "SwimIdle")

	-- Fallbacks

	if Animation1 == 0 then
		Animation1 = Idle
	end

	if Animation2 == 0 then
		Animation2 = Animation1
	end

	-- Find name

	local PackName = findPackName({

		Walk,
		Run,
		Jump,
		Fall,
		Climb,
		Swim,
		Animation1,
		Animation2

	})

	--==================================================
	-- OUTPUT
	--==================================================

	local Output = string.format([[
["%s"] = {
	WalkAnim = %d,
	RunAnim = %d,
	JumpAnim = %d,
	FallAnim = %d,
	SwimIdle = %d,
	Swim = %d,
	Animation1 = %d,
	Animation2 = %d,
	ClimbAnim = %d
},]],

		PackName,
		Walk,
		Run,
		Jump,
		Fall,
		SwimIdle,
		Swim,
		Animation1,
		Animation2,
		Climb

	)

	Box.Text = Output

	Status.Text = "Pack found: " .. PackName

end

--==================================================
-- BUTTONS
--==================================================

Fetch.MouseButton1Click:Connect(function()

	Fetch.Text = "..."

	task.spawn(function()

		fetchPack()

		Fetch.Text = "FETCH"

	end)

end)


Copy.MouseButton1Click:Connect(function()

	if Box.Text == "" then
		return
	end

	if setclipboard then

		setclipboard(Box.Text)

		Copy.Text = "COPIED"

		task.delay(1, function()
			Copy.Text = "COPY"
		end)

	else

		Copy.Text = "NO CLIPBOARD"

		task.delay(1, function()
			Copy.Text = "COPY"
		end)

	end

end) 
]]
